-- =====================================================================
-- SISACFO - Migración SISA - Archivo 11 (solo lo requerido para las
-- consultas finales de contratos, OC, ingresos y facturas)
-- 1) Columnas de las tablas en alcance   2) PK/UK   3) FK hacia padres
-- 4) Catálogos TIC y PDF   5) Dos controles de cierre
-- Pegue cada "Resultado" debajo de su bloque, como en las rondas anteriores.
-- =====================================================================

-- ---------------------------------------------------------------------
-- 1. Columnas (nombre, tipo, longitud, precisión, obligatoria)
-- ---------------------------------------------------------------------
SELECT table_name, column_id, column_name, data_type, data_length,
       data_precision, data_scale, nullable
FROM all_tab_columns
WHERE owner = 'SISACFO'
  AND table_name IN ('TSS_CON_ENCA_CONTRATO_REG','TSS_CON_ARRI_CONTRATO','TSS_CON_ARRI_CONTRATO_REG',
                     'TSS_CON_VLR_CONTRATO','TSS_CON_VLR_CONTRATO_REG','TSS_CON_ESTADO_CONTRATO',
                     'TSS_CON_ESTADO_CONTRATO_REG','TSS_CON_DETA_REGISTRO','TSS_CON_CLAUSULA',
                     'TSS_CON_INCREMENTO_CONTRATO','TSS_CON_VLR_ESTIMADO','TSS_CON_VISACION',
                     'TSS_CON_EJECUCION','ENCA_COMPRA','DETA_COMPRA','TSS_ORD_DETA_ENTREGA',
                     'TSS_ORD_APROB_COMPRA','ENCA_INGRESO','DETA_INGRESO','TSS_ORDENES_ING_DIRECTOS',
                     'ENCA_FACTURA','DETA_FACTURA','TSS_PAG_ADEL_EFAC','TSS_MAN_DOCUMENTO')
ORDER BY table_name, column_id;

-- ---------------------------------------------------------------------
-- 2. Llaves primarias y únicas
-- ---------------------------------------------------------------------
SELECT c.table_name, c.constraint_type, c.constraint_name, cc.position, cc.column_name
FROM all_constraints c
JOIN all_cons_columns cc ON cc.owner = c.owner AND cc.constraint_name = c.constraint_name
WHERE c.owner = 'SISACFO' AND c.constraint_type IN ('P','U')
  AND c.table_name IN ('TSS_CON_ENCA_CONTRATO','TSS_CON_ENCA_CONTRATO_REG','TSS_CON_ARRI_CONTRATO',
                       'TSS_CON_ARRI_CONTRATO_REG','TSS_CON_VLR_CONTRATO','TSS_CON_VLR_CONTRATO_REG',
                       'TSS_CON_ESTADO_CONTRATO','TSS_CON_ESTADO_CONTRATO_REG','TSS_CON_DETA_REGISTRO',
                       'TSS_CON_CLAUSULA','TSS_CON_INCREMENTO_CONTRATO','TSS_CON_VLR_ESTIMADO',
                       'TSS_CON_VISACION','TSS_CON_EJECUCION','ENCA_COMPRA','DETA_COMPRA',
                       'TSS_ORD_DETA_ENTREGA','TSS_ORD_APROB_COMPRA','ENCA_INGRESO','DETA_INGRESO',
                       'TSS_ORDENES_ING_DIRECTOS','ENCA_FACTURA','DETA_FACTURA','TSS_PAG_ADEL_EFAC',
                       'TSS_MAN_DOCUMENTO')
ORDER BY c.table_name, c.constraint_type, c.constraint_name, cc.position;

-- ---------------------------------------------------------------------
-- 3. Llaves foráneas: hija -> padre, con columnas y filas aprox. del padre
--    (así se ve qué padres faltan por migrar, incluidos cotización y pedido)
-- ---------------------------------------------------------------------
SELECT a.table_name AS hija, ac.column_name AS col_hija,
       r.table_name AS padre, rc.column_name AS col_padre, t.num_rows AS filas_padre_aprox
FROM all_constraints a
JOIN all_cons_columns ac ON ac.owner = a.owner AND ac.constraint_name = a.constraint_name
JOIN all_constraints r   ON r.owner = a.r_owner AND r.constraint_name = a.r_constraint_name
JOIN all_cons_columns rc ON rc.owner = r.owner AND rc.constraint_name = r.constraint_name
                        AND rc.position = ac.position
LEFT JOIN all_tables t   ON t.owner = r.owner AND t.table_name = r.table_name
WHERE a.constraint_type = 'R' AND a.owner = 'SISACFO'
  AND a.table_name IN ('TSS_CON_ENCA_CONTRATO','TSS_CON_ENCA_CONTRATO_REG','TSS_CON_ARRI_CONTRATO',
                       'TSS_CON_ARRI_CONTRATO_REG','TSS_CON_VLR_CONTRATO','TSS_CON_VLR_CONTRATO_REG',
                       'TSS_CON_ESTADO_CONTRATO','TSS_CON_ESTADO_CONTRATO_REG','TSS_CON_DETA_REGISTRO',
                       'TSS_CON_CLAUSULA','TSS_CON_INCREMENTO_CONTRATO','TSS_CON_VLR_ESTIMADO',
                       'TSS_CON_VISACION','TSS_CON_EJECUCION','ENCA_COMPRA','DETA_COMPRA',
                       'TSS_ORD_DETA_ENTREGA','TSS_ORD_APROB_COMPRA','ENCA_INGRESO','DETA_INGRESO',
                       'TSS_ORDENES_ING_DIRECTOS','ENCA_FACTURA','DETA_FACTURA','TSS_PAG_ADEL_EFAC',
                       'TSS_MAN_DOCUMENTO')
ORDER BY a.table_name, r.table_name, ac.column_name;

-- ---------------------------------------------------------------------
-- 4. Catálogos que faltan: TIC (INCO_TIPO), PDF (COD_ITEM_PDF), PDC (descuento
--    comercial en DETA_FACTURA). Si PDF/PDC no existen, el resultado sale vacío.
-- ---------------------------------------------------------------------
SELECT COD_CODIGO, COD_ITEM, COD_NOMBRE
FROM SISACFO.CODIGOS
WHERE COD_CODIGO IN ('TIC','PDF','PDC')
ORDER BY COD_CODIGO, COD_ITEM;

-- ---------------------------------------------------------------------
-- 5. Controles de cierre (los padres TAPA y TSS_RAD_RADICACION están vacíos,
--    entonces estas columnas deberían ser todas NULL)
-- ---------------------------------------------------------------------
SELECT 'ENCA_FACTURA.TAPA_CONSECU' AS columna, COUNT(TAPA_CONSECU) AS no_nulos FROM SISACFO.ENCA_FACTURA
UNION ALL SELECT 'ENCA_INGRESO.TAPA_CONSECU',       COUNT(TAPA_CONSECU) FROM SISACFO.ENCA_INGRESO
UNION ALL SELECT 'TSS_CON_EJECUCION.RAD_CONSECU',   COUNT(RAD_CONSECU)  FROM SISACFO.TSS_CON_EJECUCION
UNION ALL SELECT 'TSS_CON_VISACION.RAD_CONSECU',    COUNT(RAD_CONSECU)  FROM SISACFO.TSS_CON_VISACION;
