-- =====================================================================
-- SISACFO - Migración SISA - Ronda 3 (cierre)
-- Los comentarios del diccionario de datos explican varios códigos
-- (ya lo hicieron con EFAC_TIPO, EFAC_ESTADO, EING_TIPO y ECON_*).
-- Este archivo los trae todos y cierra alcance y dependencias.
-- =====================================================================

-- ---------------------------------------------------------------------
-- 1. TODOS los comentarios de columnas de las tablas en alcance
--    (incluye los campos pendientes de PROVEEDOR: PROV_BENEFI, PROV_CHEQUEO,
--     PROV_TIPO, PROV_ENDOSO)
-- ---------------------------------------------------------------------
SELECT table_name, column_name, comments
FROM all_col_comments
WHERE owner = 'SISACFO'
  AND comments IS NOT NULL
  AND table_name IN ('PROVEEDOR','TSS_PRO_MOVIMIENTO','TSS_CON_ENCA_CONTRATO','TSS_CON_ENCA_CONTRATO_REG',
                     'TSS_CON_ARRI_CONTRATO','TSS_CON_ARRI_CONTRATO_REG','TSS_CON_VLR_CONTRATO',
                     'TSS_CON_VLR_CONTRATO_REG','TSS_CON_ESTADO_CONTRATO','TSS_CON_ESTADO_CONTRATO_REG',
                     'TSS_CON_VISACION','TSS_CON_EJECUCION','ENCA_COMPRA','ENCA_INGRESO','ENCA_FACTURA',
                     'DETA_COMPRA','DETA_INGRESO','DETA_FACTURA','DETA_PEDIDO','TSS_CON_DETA_REGISTRO',
                     'TSS_CON_INCREMENTO_CONTRATO','TSS_CON_VLR_ESTIMADO','TSS_CON_CLAUSULA',
                     'TSS_OUT_ENCA_APROBACION','TSS_MAN_DOCUMENTO','TSS_PAG_ADEL_EFAC',
                     'TSS_ORD_APROB_COMPRA','TSS_ORD_DETA_REQUISITOS','TSS_ORDENES_ING_DIRECTOS')
ORDER BY table_name, column_name;

SELECT table_name, comments
FROM all_tab_comments
WHERE owner = 'SISACFO' AND comments IS NOT NULL
  AND table_name IN ('TSS_CON_ESTADO_CONTRATO','TSS_CON_DETA_REGISTRO','TSS_MAN_DOCUMENTO',
                     'TSS_ORDENES_ING_DIRECTOS','DETA_PEDIDO','TSS_OUT_ENCA_APROBACION',
                     'TSS_CON_INCREMENTO_CONTRATO','TSS_CON_VLR_ESTIMADO');

-- ---------------------------------------------------------------------
-- 2. Facturas: tipo y estado contra vínculo con contrato
--    (EFAC_TIPO = 'N' parece coincidir con las 55.250 facturas de contrato)
-- ---------------------------------------------------------------------
SELECT EFAC_TIPO, EFAC_ESTADO,
       CASE WHEN ECON_CONSECU IS NULL THEN 'SIN_CONTRATO' ELSE 'CON_CONTRATO' END AS vinculo,
       COUNT(*) AS n
FROM SISACFO.ENCA_FACTURA
GROUP BY EFAC_TIPO, EFAC_ESTADO, CASE WHEN ECON_CONSECU IS NULL THEN 'SIN_CONTRATO' ELSE 'CON_CONTRATO' END
ORDER BY 1, 2, 3;

-- ---------------------------------------------------------------------
-- 3. Facturas: cuántas entran con la regla propuesta
--    (contrato en alcance, o sin contrato y fecha dentro de la ventana)
-- ---------------------------------------------------------------------
WITH c AS (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO
           WHERE ECON_FEC_VENCE >= ADD_MONTHS(SYSDATE,-120))
SELECT
  SUM(CASE WHEN f.ECON_CONSECU IS NOT NULL AND c.ECON_CONSECU IS NOT NULL THEN 1 ELSE 0 END) AS con_contrato_en_alcance,
  SUM(CASE WHEN f.ECON_CONSECU IS NOT NULL AND c.ECON_CONSECU IS NULL     THEN 1 ELSE 0 END) AS con_contrato_fuera_alcance,
  SUM(CASE WHEN f.ECON_CONSECU IS NULL AND f.EFAC_FECHA >= ADD_MONTHS(SYSDATE,-120) THEN 1 ELSE 0 END) AS sin_contrato_en_ventana,
  SUM(CASE WHEN f.ECON_CONSECU IS NULL AND f.EFAC_FECHA <  ADD_MONTHS(SYSDATE,-120) THEN 1 ELSE 0 END) AS sin_contrato_antigua,
  SUM(CASE WHEN f.ECON_CONSECU IS NOT NULL AND c.ECON_CONSECU IS NULL
            AND f.EFAC_FECHA >= ADD_MONTHS(SYSDATE,-120) THEN 1 ELSE 0 END)                  AS recientes_de_contrato_fuera
FROM SISACFO.ENCA_FACTURA f
LEFT JOIN c ON c.ECON_CONSECU = f.ECON_CONSECU;

-- ---------------------------------------------------------------------
-- 4. Cierre de OC: órdenes fuera de la ventana de fecha que igual hay que
--    traer porque las referencia una factura o un ingreso en alcance
-- ---------------------------------------------------------------------
WITH c AS (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO
           WHERE ECON_FEC_VENCE >= ADD_MONTHS(SYSDATE,-120)),
f AS (SELECT x.ECOM_CONSECU
      FROM SISACFO.ENCA_FACTURA x
      WHERE x.ECOM_CONSECU IS NOT NULL
        AND ( x.ECON_CONSECU IN (SELECT ECON_CONSECU FROM c)
           OR (x.ECON_CONSECU IS NULL AND x.EFAC_FECHA >= ADD_MONTHS(SYSDATE,-120)) )),
i AS (SELECT d.ECOM_CONSECU
      FROM SISACFO.TSS_ORDENES_ING_DIRECTOS d
      JOIN SISACFO.ENCA_INGRESO e ON e.EING_CONSECU = d.EING_CONSECU
      WHERE e.EING_FECHA >= ADD_MONTHS(SYSDATE,-120)),
o_ventana AS (SELECT ECOM_CONSECU FROM SISACFO.ENCA_COMPRA
              WHERE ECOM_FECHA >= ADD_MONTHS(SYSDATE,-120)),
o_req AS (SELECT ECOM_CONSECU FROM f UNION SELECT ECOM_CONSECU FROM i)
SELECT (SELECT COUNT(*) FROM o_ventana) AS oc_por_fecha,
       (SELECT COUNT(*) FROM o_req
         WHERE ECOM_CONSECU NOT IN (SELECT ECOM_CONSECU FROM o_ventana)) AS oc_extra_por_cierre
FROM dual;

-- ---------------------------------------------------------------------
-- 5. DETA_INGRESO: ¿se vincula a OC, a contrato o a ambos?
-- ---------------------------------------------------------------------
SELECT COUNT(*) AS total,
       SUM(CASE WHEN ECOM_CONSECU IS NOT NULL THEN 1 ELSE 0 END)                           AS con_oc,
       SUM(CASE WHEN ECON_CONSECU IS NOT NULL THEN 1 ELSE 0 END)                           AS con_contrato,
       SUM(CASE WHEN ECOM_CONSECU IS NULL AND ECON_CONSECU IS NULL THEN 1 ELSE 0 END)      AS sin_vinculo
FROM SISACFO.DETA_INGRESO;

-- ---------------------------------------------------------------------
-- 6. TSS_MAN_DOCUMENTO: a qué apunta cada fila (tabla polimórfica; las
--    filas que apuntan a cheques, traslados o salidas salen del alcance)
-- ---------------------------------------------------------------------
SELECT COUNT(*) AS total,
       SUM(CASE WHEN ECOM_CONSECU  IS NOT NULL THEN 1 ELSE 0 END) AS oc,
       SUM(CASE WHEN ECON_CONSECU  IS NOT NULL THEN 1 ELSE 0 END) AS contrato,
       SUM(CASE WHEN CHEQ_CONSECU  IS NOT NULL THEN 1 ELSE 0 END) AS cheque,
       SUM(CASE WHEN ETRAS_CONSECU IS NOT NULL THEN 1 ELSE 0 END) AS traslado,
       SUM(CASE WHEN EREQ_CONSECU  IS NOT NULL THEN 1 ELSE 0 END) AS requisicion,
       SUM(CASE WHEN ESAL_CONSECU  IS NOT NULL THEN 1 ELSE 0 END) AS salida,
       SUM(CASE WHEN ENAP_CONSECU  IS NOT NULL THEN 1 ELSE 0 END) AS aprobacion
FROM SISACFO.TSS_MAN_DOCUMENTO;

-- ---------------------------------------------------------------------
-- 7. Volumen de los padres y maestros de los que dependen las tablas en
--    alcance (deben existir en el destino antes de cargar)
-- ---------------------------------------------------------------------
SELECT 'PRODUCTO' AS tabla, COUNT(*) AS filas FROM SISACFO.PRODUCTO
UNION ALL SELECT 'UNIDAD',              COUNT(*) FROM SISACFO.UNIDAD
UNION ALL SELECT 'IVA',                 COUNT(*) FROM SISACFO.IVA
UNION ALL SELECT 'RETENCION',           COUNT(*) FROM SISACFO.RETENCION
UNION ALL SELECT 'TIMBRE',              COUNT(*) FROM SISACFO.TIMBRE
UNION ALL SELECT 'TSS_IMP_CONSUMO',     COUNT(*) FROM SISACFO.TSS_IMP_CONSUMO
UNION ALL SELECT 'TSS_MAN_PROD_OTROS',  COUNT(*) FROM SISACFO.TSS_MAN_PROD_OTROS
UNION ALL SELECT 'ACTI_ECONOMICA',      COUNT(*) FROM SISACFO.ACTI_ECONOMICA
UNION ALL SELECT 'EMPLEADO',            COUNT(*) FROM SISACFO.EMPLEADO
UNION ALL SELECT 'ENTE',                COUNT(*) FROM SISACFO.ENTE
UNION ALL SELECT 'TAPA',                COUNT(*) FROM SISACFO.TAPA
UNION ALL SELECT 'TSS_MAN_TASA',        COUNT(*) FROM SISACFO.TSS_MAN_TASA
UNION ALL SELECT 'TSS_MAN_PERIODOS',    COUNT(*) FROM SISACFO.TSS_MAN_PERIODOS
UNION ALL SELECT 'TSS_PRO_TAR_NOVEDAD', COUNT(*) FROM SISACFO.TSS_PRO_TAR_NOVEDAD
UNION ALL SELECT 'TSS_PRO_TAR_PROV',    COUNT(*) FROM SISACFO.TSS_PRO_TAR_PROV
UNION ALL SELECT 'TSS_IVA_DESCONTABLE', COUNT(*) FROM SISACFO.TSS_IVA_DESCONTABLE
UNION ALL SELECT 'TSS_RAD_RADICACION',  COUNT(*) FROM SISACFO.TSS_RAD_RADICACION
UNION ALL SELECT 'ENCA_PEDIDO',         COUNT(*) FROM SISACFO.ENCA_PEDIDO
UNION ALL SELECT 'DETA_COTIZA',         COUNT(*) FROM SISACFO.DETA_COTIZA
UNION ALL SELECT 'TSS_ORD_DETA_ENTREGA',COUNT(*) FROM SISACFO.TSS_ORD_DETA_ENTREGA
UNION ALL SELECT 'TSS_CON_DETA_ENTREGA',COUNT(*) FROM SISACFO.TSS_CON_DETA_ENTREGA
UNION ALL SELECT 'ENCA_SALIDA',         COUNT(*) FROM SISACFO.ENCA_SALIDA
UNION ALL SELECT 'CHEQUE',              COUNT(*) FROM SISACFO.CHEQUE
UNION ALL SELECT 'TSS_ACF_ENCA_TRASLADO', COUNT(*) FROM SISACFO.TSS_ACF_ENCA_TRASLADO
ORDER BY 2 DESC;

-- ---------------------------------------------------------------------
-- 8. Tablas de la familia PRODUCTO (nombres reales, no supuestos) y
--    columnas de CC1..CC4 y CENTROS_VI (nombres de centros de costo)
-- ---------------------------------------------------------------------
SELECT table_name, num_rows FROM all_tables
WHERE owner = 'SISACFO' AND (table_name LIKE '%PRODUCTO%' OR table_name LIKE 'CLAS%' OR table_name LIKE 'GRUP%' OR table_name LIKE 'GENE%')
ORDER BY 1;

SELECT table_name, column_id, column_name, data_type, data_length
FROM all_tab_columns
WHERE owner = 'SISACFO' AND table_name IN ('CC1','CC2','CC3','CC4')
ORDER BY table_name, column_id;

SELECT object_type, object_name FROM all_objects
WHERE owner = 'SISACFO' AND object_name = 'CENTROS_VI';
