-- 2. EXTRACCIÓN (una consulta por tabla, en el orden de carga recomendado)
--    Orden de carga: maestros -> proveedor -> contratos -> tarifas -> pedidos ->
--    cotizaciones/OC -> ingresos -> facturas. ECON_OBJETO (LONG) viaja en las
--    tablas de contrato: configure el exportador para LONG (SET LONG 2000000).
-- =====================================================================


-- ---- MAESTROS ----
SELECT * FROM SISACFO.CODIGOS ORDER BY 1;
SELECT * FROM SISACFO.PAIS ORDER BY 1;
SELECT * FROM SISACFO.DEPTOS ORDER BY 1;
SELECT * FROM SISACFO.MUNICIPIOS ORDER BY 1;
SELECT * FROM SISACFO.EMPRESAS ORDER BY 1;
SELECT * FROM SISACFO.REGIONAL ORDER BY 1;
SELECT * FROM SISACFO.CC1 ORDER BY 1;
SELECT * FROM SISACFO.CC2 ORDER BY 1;
SELECT * FROM SISACFO.CC3 ORDER BY 1;
SELECT * FROM SISACFO.CC4 ORDER BY 1;
SELECT * FROM SISACFO.CENTROS_VI ORDER BY 1;
SELECT * FROM SISACFO.CLASI_PRODUCTO ORDER BY 1;
SELECT * FROM SISACFO.GRUPO_PRODUCTO ORDER BY 1;
SELECT * FROM SISACFO.GENE_PRODUCTO ORDER BY 1;
SELECT * FROM SISACFO.PRODUCTO ORDER BY 1;
SELECT * FROM SISACFO.UNIDAD ORDER BY 1;
SELECT * FROM SISACFO.IVA ORDER BY 1;
SELECT * FROM SISACFO.RETENCION ORDER BY 1;
SELECT * FROM SISACFO.TIMBRE ORDER BY 1;
SELECT * FROM SISACFO.TSS_IMP_CONSUMO ORDER BY 1;
SELECT * FROM SISACFO.TSS_MAN_PROD_OTROS ORDER BY 1;
SELECT * FROM SISACFO.ACTI_ECONOMICA ORDER BY 1;
SELECT * FROM SISACFO.PROV_RET_IVA ORDER BY 1;
SELECT * FROM SISACFO.TSS_IVA_DESCONTABLE ORDER BY 1;
SELECT * FROM SISACFO.TSS_MAN_MONEDA ORDER BY 1;
SELECT * FROM SISACFO.TSS_MAN_TASA ORDER BY 1;
SELECT * FROM SISACFO.TSS_MAN_PERIODOS ORDER BY 1;
SELECT EMPR_CONSECU, ENT_CODIGO, ENT_NOMBRE, ENT_VALOR_MAX, ENT_VALIDA, ENT_FECHA_ACTI, ENT_TIPO, ENT_ESTADO FROM SISACFO.ENTE ORDER BY EMPR_CONSECU, ENT_CODIGO;   -- sin ENT_CLAVE
SELECT EMP_CODIGO, EMP_CEDULA, EMP_APELLIDO1, EMP_APELLIDO2, EMP_NOMBRES, EMPR_CONSECU, REGI_CONSECU, CC1_CODIGO, CC2_CODIGO, CC3_CODIGO, CC4_CODIGO, CARGO_CODIGO, CARGO_NOMBRE, EMP_ESTADO, EMP_GRADO_CODIGO, EMP_TIPO_EMPLEADO, EMP_OBSERVACION, EMP_USER_EMPRESA, USERNAME, EMP_CREA_SOLI, EMP_EXTENCION, ENT_CODIGO, EMP_TIPO_PAGO, EMP_EMAIL, EMP_TIPO_DOC, EMP_USU_EMAIL, EMP_AUT_CO, EMP_CENTRO_CODIGO, EMP_NOMBRE_COMPLETO, EMP_MULTI_EMPR, EMP_RET_PCT FROM SISACFO.EMPLEADO ORDER BY EMP_CODIGO;   -- sin clave ni datos bancarios

-- ---- PROVEEDOR ----
SELECT * FROM SISACFO.PROVEEDOR ORDER BY PROV_DOCUMENTO;
SELECT * FROM SISACFO.TSS_PRO_MOVIMIENTO ORDER BY PROV_DOCUMENTO, PROM_LINEA;

