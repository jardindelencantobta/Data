-- ---------------------------------------------------------------------
-- 1. Cuántos contratos entran según cada regla candidata
-- ---------------------------------------------------------------------
SELECT COUNT(*) AS total,
       SUM(CASE WHEN ECON_ESTADO <> '003' THEN 1 ELSE 0 END)                           AS no_terminados,
       SUM(CASE WHEN ECON_FEC_VENCE >= ADD_MONTHS(SYSDATE,-120) THEN 1 ELSE 0 END)     AS solo_por_vence,
       SUM(CASE WHEN ECON_ESTADO <> '003'
                  OR ECON_FEC_VENCE >= ADD_MONTHS(SYSDATE,-120) THEN 1 ELSE 0 END)    AS no_terminado_o_vence
FROM SISACFO.TSS_CON_ENCA_CONTRATO;

