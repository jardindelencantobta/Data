-- #####################################################################
-- PARTE A - MUESTRAS PARA EL USUARIO FINAL
-- #####################################################################

-- ---------------------------------------------------------------------
-- A1. PROVEEDORES (muestra de 100 + controles)
-- ---------------------------------------------------------------------
SELECT
       P.PROV_DOCUMENTO,
       P.PROV_TIPO_DOC,
       TP.COD_NOMBRE               AS PROV_TIPO_DOC_DESC,
       P.PROV_NOMBRE,
       P.PROV_REP_NOMBRE,
       P.PROV_REP_APE1,
       P.PROV_REP_APE2,
       P.PROV_CONT_NOMBRE,
       P.PROV_CONT_APE1,
       P.PROV_CONT_APE2,
       P.PROV_REGISTRO,
       P.PROV_CLASE,
       DIP.COD_NOMBRE              AS PROV_CLASE_DESC,
       P.PROV_DIRECCION,
       P.PROV_FAX,
       P.PROV_TRIBUTA,
       CASE P.PROV_TRIBUTA
            WHEN 'A' THEN 'AUTORETENEDOR'
            WHEN 'N' THEN 'NO AUTORETENEDOR'
       END                         AS PROV_TRIBUTA_DESC,
       P.PROV_ESTADO,
       ESPR.COD_NOMBRE             AS PROV_ESTADO_DESC,
       P.PROV_ULT_COMPRA,
       P.PROV_VENCE,
       P.DEP_CODIGO,
       D.DEP_NOMBRE                AS DEPARTAMENTO_DESCRIPCION,
       P.MUN_CODIGO,
       M.MUN_NOMBRE                AS MUNICIPIO_DESCRIPCION,
       P.PROV_CHEQUEO,                                   -- PENDIENTE de decodificar
       P.PROV_DEDICA,
       AE.ACTE_NOMBRE              AS PROV_DEDICA_DESC,
       P.PROV_BENEFI,                                    -- PENDIENTE de decodificar
       P.PROV_SIGLA,
       P.PROV_A_A_NRO,
       P.PROV_FE_I_REGIS,
       P.PROV_FE_F_REGIS,
       P.DEP_CODIGO_REGIS,
       P.MUN_CODIGO_REGIS,
       P.PROV_NOTARIA_REGIS,
       P.DEP_CODIGO_NOTA,
       P.MUN_CODIGO_NOTA,
       P.PROV_ESCRITURA_NUM,
       P.PROV_FE_F_SOCIEDAD,
       P.PROV_MONTO_MAX,
       P.PROV_CAPITAL_PAGADO,
       P.PROV_AVALUA,
       P.PRETI_CODIGO,
       PR.PRETI_NOMBRE             AS RETENCION_IVA_DESCRIPCION,
       PR.PRETI_PCT                AS RETENCION_IVA_PORCENTAJE,
       PR.PRETI_APLICA             AS RETENCION_IVA_APLICA,
       PR.PRETI_RETICA             AS RETENCION_IVA_RETICA,
       P.PAI_CODIGO,
       PA.PAI_NOMBRE               AS PAIS_DESCRIPCION,
       P.PAI_CODIGO_REGIS,
       P.PAI_CODIGO_NOTA,
       P.PROV_TIPO_NEGOCIO,
       TDN.COD_NOMBRE              AS PROV_TIPO_NEGOCIO_DESC,
       P.PROV_NRO_REF,
       P.PROV_FEC_ULT_REF,
       P.PROV_NOTA_REF,
       P.PROV_PAI,
       P.PROV_DEP,
       P.PROV_MUN,
       P.PROV_FEC_ULT_CAMP,
       P.PROV_MOT_REF,
       P.PROV_ATR_REF,
       P.PROV_ATR_VAL_REP,
       P.PROV_ACT_LIM_REP,
       P.PROV_VAL_ACT_REP,
       P.PROV_VAL_ACTIVOS,
       P.PROV_FEC_ACTIVOS,
       P.PROV_VAL_INGRESOS,
       P.PROV_FEC_INGRESOS,
       P.COD_PROV_DED,
       P.PROV_CUENTA,
       P.PROV_BANCO,
       P.PROV_NRO_REFS,
       P.PROV_CARGA,
       P.PROV_REP_PAI,
       P.PROV_REP_DEP,
       P.PROV_REP_MUN,
       P.PROV_REP_TEL,
       P.PROV_REP_FAX,
       P.PROV_TIPO,                                      -- PENDIENTE de decodificar
       P.PROV_PAGO_AUT,
       P.PROV_SAP,
       P.ENT_CODIGO,
       P.PROV_TERMINAL,
       P.PROV_USUARIO,
       P.PROV_SYSDATE,
       P.PROV_BASE,
       P.PROV_WEB_SITE,
       P.PROV_EMAIL,
       P.PROV_TIPO_ENTIDAD,
       TEP.COD_NOMBRE              AS PROV_TIPO_ENTIDAD_DESC,
       P.PROV_GRUPO_ECONOMICO,
       GRP.COD_NOMBRE              AS PROV_GRUPO_ECONOMICO_DESC,
       P.PROV_SOCIEDAD,
       TSP.COD_NOMBRE              AS PROV_SOCIEDAD_DESC,
       P.PROV_NATURALEZA_JURIDICA,
       TNJ.COD_NOMBRE              AS PROV_NATURALEZA_JURIDICA_DESC,
       P.PROV_DECLARA,
       P.PROV_TIPDOC_OTRO,
       P.PROV_TIPO_PAGO,
       PAG.COD_NOMBRE              AS PROV_TIPO_PAGO_DESC,
       P.EMPR_CONSECU_COLOCACION,
       P.REGI_CONSECU_COLOCACION,
       P.CC1_CODIGO_COLOCACION,
       P.CC2_CODIGO_COLOCACION,
       P.CC3_CODIGO_COLOCACION,
       P.CC4_CODIGO_COLOCACION,
       P.PROV_DOMICILIO,
       P.PROV_EFAC_CONSECU,
       P.PROV_CARPETA,
       P.EMPR_CONSECU_CARPETA,
       P.REGI_CONSECU_CARPETA,
       P.CC1_CODIGO_CARPETA,
       P.CC2_CODIGO_CARPETA,
       P.CC3_CODIGO_CARPETA,
       P.CC4_CODIGO_CARPETA,
       P.PROV_OBS_DOCU,
       P.PROV_ACT_DOCU,
       P.PROV_FECHA_ACTUALIZA,
       P.PROV_FEC_F_CAMARA,
       P.PROV_TAXID,
       P.PROV_TIPO_PERSONA,
       TNP.COD_NOMBRE              AS PROV_TIPO_PERSONA_DESC,
       P.PROV_TRIBUTA_CREE,
       P.ACRE_CONSECU,
       AC.ACRE_CODIGO              AS ACTIVIDAD_CREE_CODIGO,
       AC.ACRE_CONCEPTO            AS ACTIVIDAD_CREE_DESCRIPCION,
       P.PROV_DECLARA_INGRESO_INFERIOR,
       P.PROV_EMPLEADO,
       P.PROV_ZONA_FRANCA,
       P.PROV_INDICA_CERT_INDEP,
       P.PROV_SERVICIO_PERSONAL,
       P.PROV_CENTRO_CODIGO_CAR,
       P.PROV_CENTRO_CODIGO_COL,
       P.PROV_ENDOSO,                                    -- PENDIENTE de decodificar
       P.PROV_INDICA_PERS_VINC,
       NVL(P.PROV_FECHA_ACTUALIZA, P.PROV_SYSDATE) AS FECHA_REFERENCIA
FROM SISACFO.PROVEEDOR P
LEFT OUTER JOIN SISACFO.PAIS PA
       ON PA.PAI_CODIGO = P.PAI_CODIGO
LEFT OUTER JOIN SISACFO.DEPTOS D
       ON D.PAI_CODIGO = P.PAI_CODIGO
      AND D.DEP_CODIGO = P.DEP_CODIGO
LEFT OUTER JOIN SISACFO.MUNICIPIOS M
       ON M.PAI_CODIGO = P.PAI_CODIGO
      AND M.DEP_CODIGO = P.DEP_CODIGO
      AND M.MUN_CODIGO = P.MUN_CODIGO
LEFT OUTER JOIN SISACFO.PROV_RET_IVA PR
       ON PR.PRETI_CODIGO = P.PRETI_CODIGO
LEFT OUTER JOIN SISACFO.TSS_IMP_ACTI_CREE AC
       ON AC.ACRE_CONSECU = P.ACRE_CONSECU
LEFT OUTER JOIN SISACFO.ACTI_ECONOMICA AE
       ON AE.ACTE_CODIGO = P.PROV_DEDICA
LEFT OUTER JOIN SISACFO.CODIGOS TP   ON TP.COD_CODIGO   = 'TDI' AND TP.COD_ITEM   = P.PROV_TIPO_DOC
LEFT OUTER JOIN SISACFO.CODIGOS ESPR ON ESPR.COD_CODIGO = 'EPR' AND ESPR.COD_ITEM = P.PROV_ESTADO
LEFT OUTER JOIN SISACFO.CODIGOS DIP  ON DIP.COD_CODIGO  = 'DIP' AND DIP.COD_ITEM  = P.PROV_CLASE
LEFT OUTER JOIN SISACFO.CODIGOS TEP  ON TEP.COD_CODIGO  = 'TEP' AND TEP.COD_ITEM  = P.PROV_TIPO_ENTIDAD
LEFT OUTER JOIN SISACFO.CODIGOS GRP  ON GRP.COD_CODIGO  = 'GRP' AND GRP.COD_ITEM  = P.PROV_GRUPO_ECONOMICO
LEFT OUTER JOIN SISACFO.CODIGOS TSP  ON TSP.COD_CODIGO  = 'TSP' AND TSP.COD_ITEM  = P.PROV_SOCIEDAD
LEFT OUTER JOIN SISACFO.CODIGOS TNJ  ON TNJ.COD_CODIGO  = 'TNJ' AND TNJ.COD_ITEM  = P.PROV_NATURALEZA_JURIDICA
LEFT OUTER JOIN SISACFO.CODIGOS TNP  ON TNP.COD_CODIGO  = 'TNP' AND TNP.COD_ITEM  = P.PROV_TIPO_PERSONA
LEFT OUTER JOIN SISACFO.CODIGOS PAG  ON PAG.COD_CODIGO  = 'PAG' AND PAG.COD_ITEM  = P.PROV_TIPO_PAGO
LEFT OUTER JOIN SISACFO.CODIGOS TDN  ON TDN.COD_CODIGO  = 'TDN' AND TDN.COD_ITEM  = P.PROV_TIPO_NEGOCIO
ORDER BY NVL(P.PROV_FECHA_ACTUALIZA, P.PROV_SYSDATE) DESC NULLS LAST,
         P.PROV_DOCUMENTO
FETCH FIRST 100 ROWS ONLY;

-- ---------------------------------------------------------------------
-- Control 1: los joins no deben multiplicar filas (ambos conteos iguales)
-- ---------------------------------------------------------------------
SELECT
  (SELECT COUNT(*) FROM SISACFO.PROVEEDOR) AS filas_proveedor,
  (SELECT COUNT(*)
     FROM SISACFO.PROVEEDOR P
     LEFT OUTER JOIN SISACFO.PAIS PA ON PA.PAI_CODIGO = P.PAI_CODIGO
     LEFT OUTER JOIN SISACFO.DEPTOS D ON D.PAI_CODIGO = P.PAI_CODIGO AND D.DEP_CODIGO = P.DEP_CODIGO
     LEFT OUTER JOIN SISACFO.MUNICIPIOS M ON M.PAI_CODIGO = P.PAI_CODIGO AND M.DEP_CODIGO = P.DEP_CODIGO AND M.MUN_CODIGO = P.MUN_CODIGO
     LEFT OUTER JOIN SISACFO.PROV_RET_IVA PR ON PR.PRETI_CODIGO = P.PRETI_CODIGO
     LEFT OUTER JOIN SISACFO.TSS_IMP_ACTI_CREE AC ON AC.ACRE_CONSECU = P.ACRE_CONSECU
     LEFT OUTER JOIN SISACFO.ACTI_ECONOMICA AE ON AE.ACTE_CODIGO = P.PROV_DEDICA
     LEFT OUTER JOIN SISACFO.CODIGOS TP   ON TP.COD_CODIGO   = 'TDI' AND TP.COD_ITEM   = P.PROV_TIPO_DOC
     LEFT OUTER JOIN SISACFO.CODIGOS ESPR ON ESPR.COD_CODIGO = 'EPR' AND ESPR.COD_ITEM = P.PROV_ESTADO
     LEFT OUTER JOIN SISACFO.CODIGOS DIP  ON DIP.COD_CODIGO  = 'DIP' AND DIP.COD_ITEM  = P.PROV_CLASE
     LEFT OUTER JOIN SISACFO.CODIGOS TEP  ON TEP.COD_CODIGO  = 'TEP' AND TEP.COD_ITEM  = P.PROV_TIPO_ENTIDAD
     LEFT OUTER JOIN SISACFO.CODIGOS GRP  ON GRP.COD_CODIGO  = 'GRP' AND GRP.COD_ITEM  = P.PROV_GRUPO_ECONOMICO
     LEFT OUTER JOIN SISACFO.CODIGOS TSP  ON TSP.COD_CODIGO  = 'TSP' AND TSP.COD_ITEM  = P.PROV_SOCIEDAD
     LEFT OUTER JOIN SISACFO.CODIGOS TNJ  ON TNJ.COD_CODIGO  = 'TNJ' AND TNJ.COD_ITEM  = P.PROV_NATURALEZA_JURIDICA
     LEFT OUTER JOIN SISACFO.CODIGOS TNP  ON TNP.COD_CODIGO  = 'TNP' AND TNP.COD_ITEM  = P.PROV_TIPO_PERSONA
     LEFT OUTER JOIN SISACFO.CODIGOS PAG  ON PAG.COD_CODIGO  = 'PAG' AND PAG.COD_ITEM  = P.PROV_TIPO_PAGO
     LEFT OUTER JOIN SISACFO.CODIGOS TDN  ON TDN.COD_CODIGO  = 'TDN' AND TDN.COD_ITEM  = P.PROV_TIPO_NEGOCIO
  ) AS filas_con_joins
FROM dual;

-- ---------------------------------------------------------------------
-- Control 2: valores sin descripción (código lleno pero join sin resultado).
-- Cada fila con huerfanos > 0 es un código que no existe en su catálogo.
-- ---------------------------------------------------------------------
SELECT 'PROV_ESTADO' AS campo, COUNT(*) AS huerfanos
FROM SISACFO.PROVEEDOR P
WHERE P.PROV_ESTADO IS NOT NULL
  AND NOT EXISTS (SELECT 1 FROM SISACFO.CODIGOS c WHERE c.COD_CODIGO='EPR' AND c.COD_ITEM=P.PROV_ESTADO)
UNION ALL SELECT 'PROV_CLASE', COUNT(*) FROM SISACFO.PROVEEDOR P
WHERE P.PROV_CLASE IS NOT NULL
  AND NOT EXISTS (SELECT 1 FROM SISACFO.CODIGOS c WHERE c.COD_CODIGO='DIP' AND c.COD_ITEM=P.PROV_CLASE)
UNION ALL SELECT 'PROV_TIPO_NEGOCIO', COUNT(*) FROM SISACFO.PROVEEDOR P
WHERE P.PROV_TIPO_NEGOCIO IS NOT NULL
  AND NOT EXISTS (SELECT 1 FROM SISACFO.CODIGOS c WHERE c.COD_CODIGO='TDN' AND c.COD_ITEM=P.PROV_TIPO_NEGOCIO)
UNION ALL SELECT 'PROV_TIPO_PERSONA', COUNT(*) FROM SISACFO.PROVEEDOR P
WHERE P.PROV_TIPO_PERSONA IS NOT NULL
  AND NOT EXISTS (SELECT 1 FROM SISACFO.CODIGOS c WHERE c.COD_CODIGO='TNP' AND c.COD_ITEM=P.PROV_TIPO_PERSONA)
UNION ALL SELECT 'PROV_TIPO_PAGO', COUNT(*) FROM SISACFO.PROVEEDOR P
WHERE P.PROV_TIPO_PAGO IS NOT NULL
  AND NOT EXISTS (SELECT 1 FROM SISACFO.CODIGOS c WHERE c.COD_CODIGO='PAG' AND c.COD_ITEM=P.PROV_TIPO_PAGO)
UNION ALL SELECT 'PROV_TIPO_ENTIDAD', COUNT(*) FROM SISACFO.PROVEEDOR P
WHERE P.PROV_TIPO_ENTIDAD IS NOT NULL
  AND NOT EXISTS (SELECT 1 FROM SISACFO.CODIGOS c WHERE c.COD_CODIGO='TEP' AND c.COD_ITEM=P.PROV_TIPO_ENTIDAD)
UNION ALL SELECT 'PROV_GRUPO_ECONOMICO', COUNT(*) FROM SISACFO.PROVEEDOR P
WHERE P.PROV_GRUPO_ECONOMICO IS NOT NULL
  AND NOT EXISTS (SELECT 1 FROM SISACFO.CODIGOS c WHERE c.COD_CODIGO='GRP' AND c.COD_ITEM=P.PROV_GRUPO_ECONOMICO)
UNION ALL SELECT 'PROV_SOCIEDAD', COUNT(*) FROM SISACFO.PROVEEDOR P
WHERE P.PROV_SOCIEDAD IS NOT NULL
  AND NOT EXISTS (SELECT 1 FROM SISACFO.CODIGOS c WHERE c.COD_CODIGO='TSP' AND c.COD_ITEM=P.PROV_SOCIEDAD)
UNION ALL SELECT 'PROV_NATURALEZA_JURIDICA', COUNT(*) FROM SISACFO.PROVEEDOR P
WHERE P.PROV_NATURALEZA_JURIDICA IS NOT NULL
  AND NOT EXISTS (SELECT 1 FROM SISACFO.CODIGOS c WHERE c.COD_CODIGO='TNJ' AND c.COD_ITEM=P.PROV_NATURALEZA_JURIDICA)
UNION ALL SELECT 'PROV_DEDICA', COUNT(*) FROM SISACFO.PROVEEDOR P
WHERE P.PROV_DEDICA IS NOT NULL
  AND NOT EXISTS (SELECT 1 FROM SISACFO.ACTI_ECONOMICA a WHERE a.ACTE_CODIGO = P.PROV_DEDICA);

