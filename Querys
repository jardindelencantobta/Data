-- =====================================================================
-- SISACFO - Migración SISA - PAQUETE FINAL DE CONSULTAS (archivo 14)
-- Cierra: contratos, OC y cotizaciones, ingresos, facturas, pedidos de visación,
-- tarifas, maestros, proveedor. Sin DEFINE ni objetos: cada consulta es autónoma.
--
-- PARÁMETRO ÚNICO: fecha de corte DATE '2016-11-18'. Para cambiarla use
-- buscar/reemplazar sobre ese texto en todo el archivo.
--
-- REGLAS DE ALCANCE (todas derivadas de lo medido en las rondas anteriores)
--  Contratos : ECON_FEC_VENCE >= corte (1.181).
--  Facturas  : de contratos en alcance, o con EFAC_FECHA >= corte, o referenciadas
--              por ejecución/visación de contratos en alcance.
--  Ingresos  : EING_FECHA >= corte.
--  OC        : ECOM_FECHA >= corte, o referenciadas por facturas/ingresos en alcance.
--  Cotización: las referenciadas por líneas de OC en alcance.
--  Pedidos   : los referenciados por visaciones de contratos en alcance (ENCA_CONSECU)
--              o con DETA_PEDIDO.ECON_CONSECU en alcance; aprobaciones outsourcing: ENAP de visaciones.
--  Tarifas   : novedades de contratos/pedidos en alcance, con su cadena TNOV_CONSECU_BASE.
--  Maestros  : completos. Proveedor y sus movimientos: completos.
--  Excluido por decisión: contratos eliminados (171 REG sin contrato), cheques, traslados,
--  salidas, radicación, tarjetas (tablas vacías o sin vínculo con el alcance).
-- SEGURIDAD: EMPLEADO sin clave ni datos bancarios; ENTE sin ENT_CLAVE. Enmascarar en PROVEEDOR
--  los datos sensibles según lo acordado antes de entregar a terceros.
-- EXPORTE los bloques 2 a un archivo (CSV/INSERT); no los pegue en el chat (volúmenes grandes).
-- =====================================================================


-- =====================================================================
-- 1. MUESTRAS DE 100 REGISTROS RECIENTES CON DESCRIPCIONES (validación del usuario final)
-- =====================================================================

-- 1.1 CONTRATOS (corregida: el centro de costo se une por ECON_CENTRO_CODIGO)
SELECT t.*, c.ECON_OBJETO
FROM (
  SELECT c.ECON_CONSECU, c.ECON_NUMERO, c.ECON_CONSECU_DE, c.ECON_NRO_OTRO_SI, c.ECON_TIPO_OTRO_SI,
         c.ECON_ESTADO, NVL(ce.COD_NOMBRE,'SIN CATALOGO (' || c.ECON_ESTADO || ')') AS ECON_ESTADO_DESC,
         c.ECON_TIPO,   NVL(ct.COD_NOMBRE,'SIN CATALOGO (' || c.ECON_TIPO   || ')') AS ECON_TIPO_DESC,
         c.ECON_TIPO_DOCU, c.ETIP_TIPO, c.ETIP_TIPO2, c.ETIP_TIPO3, c.ECON_CLASE,
         c.PROV_DOCUMENTO, p.PROV_NOMBRE,
         TO_CHAR(c.ECON_FEC_EXPED,'YYYY-MM-DD') AS ECON_FEC_EXPED, TO_CHAR(c.ECON_FEC_INICI,'YYYY-MM-DD') AS ECON_FEC_INICI_VISACION,
         TO_CHAR(c.ECON_FEC_INI_CONT,'YYYY-MM-DD') AS ECON_FEC_INI_VIGENCIA, TO_CHAR(c.ECON_FEC_VENCE,'YYYY-MM-DD') AS ECON_FEC_VENCE,
         c.ECON_FORMA_PAGO, NVL(cf.COD_NOMBRE,'SIN CATALOGO (' || c.ECON_FORMA_PAGO || ')') AS ECON_FORMA_PAGO_DESC,
         c.ECON_TIPO_CUANTIA, CASE c.ECON_TIPO_CUANTIA WHEN '001' THEN 'DETERMINADA' WHEN '002' THEN 'INDETERMINADA' END AS ECON_TIPO_CUANTIA_DESC,
         c.ECON_TIPO_RECAUDO, CASE c.ECON_TIPO_RECAUDO WHEN '001' THEN 'FACTURA' WHEN '002' THEN 'ORDENES DE COBRO' END AS ECON_TIPO_RECAUDO_DESC,
         c.ECON_TIPO_RECAUDO_TIMBRE, CASE c.ECON_TIPO_RECAUDO_TIMBRE WHEN '001' THEN 'FACTURA' WHEN '002' THEN 'ORDENES DE COBRO' END AS ECON_RECAUDO_TIMBRE_DESC,
         c.ECON_TIPO_PROCEDENCIA, CASE c.ECON_TIPO_PROCEDENCIA WHEN '001' THEN 'AUTOMATICA' WHEN '002' THEN 'NORMAL' WHEN '003' THEN 'ALTA' END AS ECON_PROCEDENCIA_DESC,
         c.ECON_TIPO_GASTO, CASE c.ECON_TIPO_GASTO WHEN 'A' THEN 'AMORTIZABLE' WHEN 'N' THEN 'SE LLEVA AL GASTO' END AS ECON_TIPO_GASTO_DESC,
         c.ECON_PROVISION, CASE c.ECON_PROVISION WHEN 'S' THEN 'CON PROVISION' WHEN 'N' THEN 'SIN PROVISION' END AS ECON_PROVISION_DESC,
         c.ECON_CONTROL_EJEC, c.ECON_CAUSACION,
         c.EMPR_CONSECU, em.EMPR_NOMBRE, c.REGI_CONSECU, rg.REGI_NOMBRE,
         c.ECON_CENTRO_CODIGO, cv.NOMBRE AS CENTRO_COSTO_NOMBRE,
         c.ENT_CODIGO, en.ENT_NOMBRE, c.EMP_CODIGO_SUPER, sp.EMP_NOMBRE_COMPLETO AS SUPERVISOR_NOMBRE,
         c.PAI_CODIGO, c.DEP_CODIGO, c.MUN_CODIGO, c.TNOV_CONSECU,
         c.ECON_USER, TO_CHAR(c.ECON_SYSDATE,'YYYY-MM-DD HH24:MI:SS') AS ECON_SYSDATE
  FROM SISACFO.TSS_CON_ENCA_CONTRATO c
  LEFT JOIN SISACFO.PROVEEDOR p   ON p.PROV_DOCUMENTO = c.PROV_DOCUMENTO
  LEFT JOIN SISACFO.CODIGOS ce    ON ce.COD_CODIGO = 'EPC' AND ce.COD_ITEM = c.ECON_ESTADO
  LEFT JOIN SISACFO.CODIGOS ct    ON ct.COD_CODIGO = 'DTC' AND ct.COD_ITEM = c.ECON_TIPO
  LEFT JOIN SISACFO.CODIGOS cf    ON cf.COD_CODIGO = 'TFP' AND cf.COD_ITEM = c.ECON_FORMA_PAGO
  LEFT JOIN SISACFO.EMPRESAS em   ON em.EMPR_CONSECU = c.EMPR_CONSECU
  LEFT JOIN SISACFO.REGIONAL rg   ON rg.REGI_CONSECU = c.REGI_CONSECU AND rg.EMPR_CONSECU = c.EMPR_CONSECU
  LEFT JOIN SISACFO.CENTROS_VI cv ON cv.CENTRO_CODIGO = c.ECON_CENTRO_CODIGO
  LEFT JOIN SISACFO.ENTE en       ON en.EMPR_CONSECU = c.EMPR_CONSECU AND en.ENT_CODIGO = c.ENT_CODIGO
  LEFT JOIN SISACFO.EMPLEADO sp   ON sp.EMP_CODIGO = c.EMP_CODIGO_SUPER
  WHERE c.ECON_FEC_VENCE >= DATE '2016-11-18'
  ORDER BY c.ECON_FEC_EXPED DESC, c.ECON_CONSECU DESC
  FETCH FIRST 100 ROWS ONLY
) t
JOIN SISACFO.TSS_CON_ENCA_CONTRATO c ON c.ECON_CONSECU = t.ECON_CONSECU
ORDER BY t.ECON_FEC_EXPED DESC, t.ECON_CONSECU DESC;

-- 1.2 ÓRDENES DE COMPRA (ECOM_ESTADO y ECOM_TIPO salen crudos: sin catálogo ni comentario)
SELECT c.ECOM_CONSECU, c.ECOM_NUMERO, TO_CHAR(c.ECOM_FECHA,'YYYY-MM-DD') AS ECOM_FECHA,
       TO_CHAR(c.ECOM_FECHA_ENTREGA,'YYYY-MM-DD') AS ECOM_FECHA_ENTREGA,
       c.PROV_DOCUMENTO, p.PROV_NOMBRE, c.ECOM_ESTADO, c.ECOM_TIPO, c.ECOM_FORMA_PAGO,
       c.MON_CONSECU, mo.MON_NOMBRE, c.ECON_CONSECU,
       c.EMP_CODIGO, ep.EMP_NOMBRE_COMPLETO AS RESPONSABLE_NOMBRE,
       c.ENT_CODIGO_APROB, en.ENT_NOMBRE AS ENTE_APROBADOR,
       c.EMPR_CONSECU, em.EMPR_NOMBRE, c.ECOM_CENTRO_CODIGO, cv.NOMBRE AS CENTRO_COSTO_NOMBRE,
       c.ECOM_OBSERVACION, c.ECOM_USUARIO, TO_CHAR(c.ECOM_SYSDATE,'YYYY-MM-DD HH24:MI:SS') AS ECOM_SYSDATE
FROM SISACFO.ENCA_COMPRA c
LEFT JOIN SISACFO.PROVEEDOR p       ON p.PROV_DOCUMENTO = c.PROV_DOCUMENTO
LEFT JOIN SISACFO.TSS_MAN_MONEDA mo ON mo.MON_CONSECU = c.MON_CONSECU
LEFT JOIN SISACFO.EMPLEADO ep       ON ep.EMP_CODIGO = c.EMP_CODIGO
LEFT JOIN SISACFO.ENTE en           ON en.EMPR_CONSECU = c.EMPR_CONSECU AND en.ENT_CODIGO = c.ENT_CODIGO_APROB
LEFT JOIN SISACFO.EMPRESAS em       ON em.EMPR_CONSECU = c.EMPR_CONSECU
LEFT JOIN SISACFO.CENTROS_VI cv     ON cv.CENTRO_CODIGO = c.ECOM_CENTRO_CODIGO
WHERE c.ECOM_CONSECU IN (SELECT ECOM_CONSECU FROM SISACFO.ENCA_COMPRA WHERE ECOM_FECHA >= DATE '2016-11-18' UNION SELECT ECOM_CONSECU FROM SISACFO.ENCA_FACTURA WHERE ECOM_CONSECU IS NOT NULL AND EFAC_CONSECU IN (SELECT EFAC_CONSECU FROM SISACFO.ENCA_FACTURA WHERE ECON_CONSECU IN (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_FEC_VENCE >= DATE '2016-11-18') OR EFAC_FECHA >= DATE '2016-11-18' UNION SELECT EFAC_CONSECU FROM SISACFO.TSS_CON_EJECUCION WHERE EFAC_CONSECU IS NOT NULL AND ECON_CONSECU IN (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_FEC_VENCE >= DATE '2016-11-18') UNION SELECT EFAC_CONSECU FROM SISACFO.TSS_CON_VISACION WHERE EFAC_CONSECU IS NOT NULL AND ECON_CONSECU IN (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_FEC_VENCE >= DATE '2016-11-18')) UNION SELECT ECOM_CONSECU FROM SISACFO.DETA_FACTURA WHERE ECOM_CONSECU IS NOT NULL AND EFAC_CONSECU IN (SELECT EFAC_CONSECU FROM SISACFO.ENCA_FACTURA WHERE ECON_CONSECU IN (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_FEC_VENCE >= DATE '2016-11-18') OR EFAC_FECHA >= DATE '2016-11-18' UNION SELECT EFAC_CONSECU FROM SISACFO.TSS_CON_EJECUCION WHERE EFAC_CONSECU IS NOT NULL AND ECON_CONSECU IN (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_FEC_VENCE >= DATE '2016-11-18') UNION SELECT EFAC_CONSECU FROM SISACFO.TSS_CON_VISACION WHERE EFAC_CONSECU IS NOT NULL AND ECON_CONSECU IN (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_FEC_VENCE >= DATE '2016-11-18')) UNION SELECT ECOM_CONSECU FROM SISACFO.DETA_INGRESO WHERE ECOM_CONSECU IS NOT NULL AND EING_CONSECU IN (SELECT EING_CONSECU FROM SISACFO.ENCA_INGRESO WHERE EING_FECHA >= DATE '2016-11-18') UNION SELECT ECOM_CONSECU FROM SISACFO.TSS_ORDENES_ING_DIRECTOS WHERE EING_CONSECU IN (SELECT EING_CONSECU FROM SISACFO.ENCA_INGRESO WHERE EING_FECHA >= DATE '2016-11-18'))
ORDER BY c.ECOM_FECHA DESC NULLS LAST, c.ECOM_CONSECU DESC
FETCH FIRST 100 ROWS ONLY;

-- 1.3 INGRESOS (EING_TIPO: S semimanual, N normal; aparece I sin definir)
SELECT c.EING_CONSECU, c.EING_NUMERO, TO_CHAR(c.EING_FECHA,'YYYY-MM-DD') AS EING_FECHA,
       c.EING_NUM_REMISION, TO_CHAR(c.EING_FEC_REMISION,'YYYY-MM-DD') AS EING_FEC_REMISION,
       c.PROV_DOCUMENTO, p.PROV_NOMBRE,
       c.EING_TIPO, CASE c.EING_TIPO WHEN 'S' THEN 'SEMIMANUAL' WHEN 'N' THEN 'NORMAL' ELSE 'SIN DEFINIR' END AS EING_TIPO_DESC,
       c.EING_ESTADO, c.MON_CONSECU, mo.MON_NOMBRE,
       c.EMPR_CONSECU, em.EMPR_NOMBRE, c.EING_CENTRO_CODIGO, cv.NOMBRE AS CENTRO_COSTO_NOMBRE,
       c.ENT_CODIGO, en.ENT_NOMBRE, c.ECON_CONSECU, c.EING_OBSERVACION,
       TO_CHAR(c.EING_SYSDATE,'YYYY-MM-DD HH24:MI:SS') AS EING_SYSDATE
FROM SISACFO.ENCA_INGRESO c
LEFT JOIN SISACFO.PROVEEDOR p       ON p.PROV_DOCUMENTO = c.PROV_DOCUMENTO
LEFT JOIN SISACFO.TSS_MAN_MONEDA mo ON mo.MON_CONSECU = c.MON_CONSECU
LEFT JOIN SISACFO.EMPRESAS em       ON em.EMPR_CONSECU = c.EMPR_CONSECU
LEFT JOIN SISACFO.CENTROS_VI cv     ON cv.CENTRO_CODIGO = c.EING_CENTRO_CODIGO
LEFT JOIN SISACFO.ENTE en           ON en.EMPR_CONSECU = c.EMPR_CONSECU AND en.ENT_CODIGO = c.ENT_CODIGO
WHERE c.EING_FECHA >= DATE '2016-11-18'
ORDER BY c.EING_FECHA DESC NULLS LAST, c.EING_CONSECU DESC
FETCH FIRST 100 ROWS ONLY;

-- 1.4 FACTURAS (EFAC_TIPO N/O/W y EFAC_ESTADO J salen como SIN DEFINIR: pendientes de usuario funcional)
SELECT c.EFAC_CONSECU, c.EFAC_NUMERO, c.EFAC_NRO_PROV, TO_CHAR(c.EFAC_FECHA,'YYYY-MM-DD') AS EFAC_FECHA,
       TO_CHAR(c.EFAC_FECHA_PAGO,'YYYY-MM-DD') AS EFAC_FECHA_PAGO,
       c.PROV_DOCUMENTO, p.PROV_NOMBRE,
       c.EFAC_TIPO, CASE c.EFAC_TIPO WHEN 'A' THEN 'ADELANTO' WHEN 'I' THEN 'INGRESO AL ALMACEN' WHEN 'S' THEN 'SERVICIO' ELSE 'SIN DEFINIR' END AS EFAC_TIPO_DESC,
       c.EFAC_ESTADO, CASE c.EFAC_ESTADO WHEN 'F' THEN 'FACTURADO' WHEN 'P' THEN 'PENDIENTE' WHEN 'A' THEN 'ANULADO' ELSE 'SIN DEFINIR' END AS EFAC_ESTADO_DESC,
       c.EFAC_TOTAL, c.EFAC_IVA, c.EFAC_RETEN, c.EFAC_NETO,
       c.MON_CONSECU, mo.MON_NOMBRE, c.ECON_CONSECU, k.ECON_NUMERO, c.ECOM_CONSECU,
       c.COD_ITEM_PDF, NVL(pf.COD_NOMBRE,'SIN CATALOGO') AS COD_ITEM_PDF_DESC,
       c.EFAC_ORIGEN, c.EMPR_CONSECU, em.EMPR_NOMBRE, c.EFAC_CENTRO_CODIGO, cv.NOMBRE AS CENTRO_COSTO_NOMBRE,
       c.EFAC_OBSERVACION, c.EFAC_USER, TO_CHAR(c.EFAC_SYSDATE,'YYYY-MM-DD HH24:MI:SS') AS EFAC_SYSDATE
FROM SISACFO.ENCA_FACTURA c
LEFT JOIN SISACFO.PROVEEDOR p          ON p.PROV_DOCUMENTO = c.PROV_DOCUMENTO
LEFT JOIN SISACFO.TSS_MAN_MONEDA mo    ON mo.MON_CONSECU = c.MON_CONSECU
LEFT JOIN SISACFO.TSS_CON_ENCA_CONTRATO k ON k.ECON_CONSECU = c.ECON_CONSECU
LEFT JOIN SISACFO.CODIGOS pf           ON pf.COD_CODIGO = 'PDF' AND pf.COD_ITEM = c.COD_ITEM_PDF
LEFT JOIN SISACFO.EMPRESAS em          ON em.EMPR_CONSECU = c.EMPR_CONSECU
LEFT JOIN SISACFO.CENTROS_VI cv        ON cv.CENTRO_CODIGO = c.EFAC_CENTRO_CODIGO
WHERE c.EFAC_CONSECU IN (SELECT EFAC_CONSECU FROM SISACFO.ENCA_FACTURA WHERE ECON_CONSECU IN (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_FEC_VENCE >= DATE '2016-11-18') OR EFAC_FECHA >= DATE '2016-11-18' UNION SELECT EFAC_CONSECU FROM SISACFO.TSS_CON_EJECUCION WHERE EFAC_CONSECU IS NOT NULL AND ECON_CONSECU IN (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_FEC_VENCE >= DATE '2016-11-18') UNION SELECT EFAC_CONSECU FROM SISACFO.TSS_CON_VISACION WHERE EFAC_CONSECU IS NOT NULL AND ECON_CONSECU IN (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_FEC_VENCE >= DATE '2016-11-18'))
ORDER BY c.EFAC_FECHA DESC NULLS LAST, c.EFAC_CONSECU DESC
FETCH FIRST 100 ROWS ONLY;

-- 1.5 Control de multiplicación de filas de las muestras (cada par debe ser igual)
SELECT 'OC' AS dominio,
       (SELECT COUNT(*) FROM SISACFO.ENCA_COMPRA) AS filas_base,
       (SELECT COUNT(*) FROM SISACFO.ENCA_COMPRA c
          LEFT JOIN SISACFO.PROVEEDOR p ON p.PROV_DOCUMENTO = c.PROV_DOCUMENTO
          LEFT JOIN SISACFO.TSS_MAN_MONEDA mo ON mo.MON_CONSECU = c.MON_CONSECU
          LEFT JOIN SISACFO.EMPLEADO ep ON ep.EMP_CODIGO = c.EMP_CODIGO
          LEFT JOIN SISACFO.ENTE en ON en.EMPR_CONSECU = c.EMPR_CONSECU AND en.ENT_CODIGO = c.ENT_CODIGO_APROB
          LEFT JOIN SISACFO.EMPRESAS em ON em.EMPR_CONSECU = c.EMPR_CONSECU
          LEFT JOIN SISACFO.CENTROS_VI cv ON cv.CENTRO_CODIGO = c.ECOM_CENTRO_CODIGO) AS filas_con_join
FROM dual
UNION ALL SELECT 'INGRESOS',
       (SELECT COUNT(*) FROM SISACFO.ENCA_INGRESO),
       (SELECT COUNT(*) FROM SISACFO.ENCA_INGRESO c
          LEFT JOIN SISACFO.PROVEEDOR p ON p.PROV_DOCUMENTO = c.PROV_DOCUMENTO
          LEFT JOIN SISACFO.TSS_MAN_MONEDA mo ON mo.MON_CONSECU = c.MON_CONSECU
          LEFT JOIN SISACFO.EMPRESAS em ON em.EMPR_CONSECU = c.EMPR_CONSECU
          LEFT JOIN SISACFO.CENTROS_VI cv ON cv.CENTRO_CODIGO = c.EING_CENTRO_CODIGO
          LEFT JOIN SISACFO.ENTE en ON en.EMPR_CONSECU = c.EMPR_CONSECU AND en.ENT_CODIGO = c.ENT_CODIGO)
FROM dual
UNION ALL SELECT 'FACTURAS',
       (SELECT COUNT(*) FROM SISACFO.ENCA_FACTURA),
       (SELECT COUNT(*) FROM SISACFO.ENCA_FACTURA c
          LEFT JOIN SISACFO.PROVEEDOR p ON p.PROV_DOCUMENTO = c.PROV_DOCUMENTO
          LEFT JOIN SISACFO.TSS_MAN_MONEDA mo ON mo.MON_CONSECU = c.MON_CONSECU
          LEFT JOIN SISACFO.TSS_CON_ENCA_CONTRATO k ON k.ECON_CONSECU = c.ECON_CONSECU
          LEFT JOIN SISACFO.CODIGOS pf ON pf.COD_CODIGO = 'PDF' AND pf.COD_ITEM = c.COD_ITEM_PDF
          LEFT JOIN SISACFO.EMPRESAS em ON em.EMPR_CONSECU = c.EMPR_CONSECU
          LEFT JOIN SISACFO.CENTROS_VI cv ON cv.CENTRO_CODIGO = c.EFAC_CENTRO_CODIGO)
FROM dual;


