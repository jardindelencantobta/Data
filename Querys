-- ---------------------------------------------------------------------
-- 5. Grupos de CODIGOS que cubren cada columna codificada
--    (mismo método que en PROVEEDOR; sin resultados = valores huérfanos
--     o catálogo fuera de CODIGOS)
-- ---------------------------------------------------------------------
WITH v AS (
  SELECT 'ECON_TIPO' AS col, TO_CHAR(TRIM(ECON_TIPO)) AS val FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_TIPO IS NOT NULL GROUP BY ECON_TIPO
  UNION ALL SELECT 'ECON_ESTADO',           TO_CHAR(TRIM(ECON_ESTADO))           FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_ESTADO IS NOT NULL           GROUP BY ECON_ESTADO
  UNION ALL SELECT 'ECON_TIPO_RECAUDO',     TO_CHAR(TRIM(ECON_TIPO_RECAUDO))     FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_TIPO_RECAUDO IS NOT NULL     GROUP BY ECON_TIPO_RECAUDO
  UNION ALL SELECT 'ECON_TIPO_RECAUDO_TIMBRE', TO_CHAR(TRIM(ECON_TIPO_RECAUDO_TIMBRE)) FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_TIPO_RECAUDO_TIMBRE IS NOT NULL GROUP BY ECON_TIPO_RECAUDO_TIMBRE
  UNION ALL SELECT 'ECON_TIPO_CUANTIA',     TO_CHAR(TRIM(ECON_TIPO_CUANTIA))     FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_TIPO_CUANTIA IS NOT NULL     GROUP BY ECON_TIPO_CUANTIA
  UNION ALL SELECT 'ECON_TIPO_PROCEDENCIA', TO_CHAR(TRIM(ECON_TIPO_PROCEDENCIA)) FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_TIPO_PROCEDENCIA IS NOT NULL GROUP BY ECON_TIPO_PROCEDENCIA
  UNION ALL SELECT 'ECON_TIPO_OTRO_SI',     TO_CHAR(TRIM(ECON_TIPO_OTRO_SI))     FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_TIPO_OTRO_SI IS NOT NULL     GROUP BY ECON_TIPO_OTRO_SI
  UNION ALL SELECT 'ECON_CLASE',            TO_CHAR(TRIM(ECON_CLASE))            FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_CLASE IS NOT NULL            GROUP BY ECON_CLASE
  UNION ALL SELECT 'ECON_TIPO_COMITE',      TO_CHAR(TRIM(ECON_TIPO_COMITE))      FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_TIPO_COMITE IS NOT NULL      GROUP BY ECON_TIPO_COMITE
  UNION ALL SELECT 'ECON_TIPO_DOCU',        TO_CHAR(TRIM(ECON_TIPO_DOCU))        FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_TIPO_DOCU IS NOT NULL        GROUP BY ECON_TIPO_DOCU
  UNION ALL SELECT 'ECON_FORMA_PAGO',       TO_CHAR(TRIM(ECON_FORMA_PAGO))       FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_FORMA_PAGO IS NOT NULL       GROUP BY ECON_FORMA_PAGO
  UNION ALL SELECT 'MNT_CODIGO',            TO_CHAR(TRIM(MNT_CODIGO))            FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE MNT_CODIGO IS NOT NULL            GROUP BY MNT_CODIGO
  UNION ALL SELECT 'TIPO_PROV',             TO_CHAR(TRIM(TIPO_PROV))             FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE TIPO_PROV IS NOT NULL             GROUP BY TIPO_PROV
  UNION ALL SELECT 'ETIP_TIPO',             TO_CHAR(TRIM(ETIP_TIPO))             FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ETIP_TIPO IS NOT NULL             GROUP BY ETIP_TIPO
  UNION ALL SELECT 'ETIP_TIPO2',            TO_CHAR(TRIM(ETIP_TIPO2))            FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ETIP_TIPO2 IS NOT NULL            GROUP BY ETIP_TIPO2
  UNION ALL SELECT 'ETIP_TIPO3',            TO_CHAR(TRIM(ETIP_TIPO3))            FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ETIP_TIPO3 IS NOT NULL            GROUP BY ETIP_TIPO3
  UNION ALL SELECT 'ESCO_ESTADO',           TO_CHAR(TRIM(ESCO_ESTADO))           FROM SISACFO.TSS_CON_ESTADO_CONTRATO WHERE ESCO_ESTADO IS NOT NULL         GROUP BY ESCO_ESTADO
  UNION ALL SELECT 'ECOM_ESTADO',           TO_CHAR(TRIM(ECOM_ESTADO))           FROM SISACFO.ENCA_COMPRA WHERE ECOM_ESTADO IS NOT NULL                     GROUP BY ECOM_ESTADO
  UNION ALL SELECT 'ECOM_TIPO',             TO_CHAR(TRIM(ECOM_TIPO))             FROM SISACFO.ENCA_COMPRA WHERE ECOM_TIPO IS NOT NULL                       GROUP BY ECOM_TIPO
  UNION ALL SELECT 'EING_TIPO',             TO_CHAR(TRIM(EING_TIPO))             FROM SISACFO.ENCA_INGRESO WHERE EING_TIPO IS NOT NULL                      GROUP BY EING_TIPO
  UNION ALL SELECT 'EFAC_ESTADO',           TO_CHAR(TRIM(EFAC_ESTADO))           FROM SISACFO.ENCA_FACTURA WHERE EFAC_ESTADO IS NOT NULL                    GROUP BY EFAC_ESTADO
  UNION ALL SELECT 'EFAC_TIPO',             TO_CHAR(TRIM(EFAC_TIPO))             FROM SISACFO.ENCA_FACTURA WHERE EFAC_TIPO IS NOT NULL                      GROUP BY EFAC_TIPO
  UNION ALL SELECT 'EFAC_ORIGEN',           TO_CHAR(TRIM(EFAC_ORIGEN))           FROM SISACFO.ENCA_FACTURA WHERE EFAC_ORIGEN IS NOT NULL                    GROUP BY EFAC_ORIGEN
),
tot AS (SELECT col, COUNT(*) AS n_valores FROM v GROUP BY col)
SELECT t.col, c.COD_CODIGO, COUNT(DISTINCT v.val) AS cubiertos, t.n_valores
FROM tot t
JOIN v ON v.col = t.col
LEFT JOIN SISACFO.CODIGOS c ON TRIM(c.COD_ITEM) = v.val
GROUP BY t.col, c.COD_CODIGO, t.n_valores
HAVING COUNT(DISTINCT v.val) = t.n_valores
ORDER BY t.col, c.COD_CODIGO;

