-- =====================================================================
-- SISACFO - Migración SISA - CONTRATOS (consulta final, versión 1)
-- Alcance: contratos con ECON_FEC_VENCE >= FECHA_CORTE (regla propuesta).
-- La fecha de corte se define UNA sola vez aquí. 2016-11-18 reproduce los
-- 1.180 contratos de hoy (ADD_MONTHS(SYSDATE,-120)); cámbiela si deciden otra.
-- Supuesto a validar: TSS_CON_ENCA_CONTRATO tiene las mismas columnas que
-- TSS_CON_ENCA_CONTRATO_REG sin ECON_LINEA (60 de 61). Si una columna no
-- existe, Oracle dará ORA-00904 y se corrige sin riesgo de datos errados.
-- =====================================================================
DEFINE FECHA_CORTE = 2016-11-18

-- =====================================================================
-- A. VERIFICACIONES DE CIERRE (deciden si cotizaciones y novedades de tarifa viajan)
-- =====================================================================
-- A1. Contratos en alcance con novedad de tarifa (FK a TSS_PRO_TAR_NOVEDAD)
SELECT COUNT(*) AS contratos_alcance, COUNT(c.TNOV_CONSECU) AS con_novedad,
       COUNT(DISTINCT c.TNOV_CONSECU) AS novedades_distintas
FROM SISACFO.TSS_CON_ENCA_CONTRATO c
WHERE c.ECON_FEC_VENCE >= TO_DATE('&&FECHA_CORTE','YYYY-MM-DD');

-- A2. Líneas de OC (en ventana de fecha) que referencian cotización (FK a DETA_COTIZA)
SELECT COUNT(*) AS lineas_oc, COUNT(d.ECOT_CONSECU) AS con_cotizacion,
       COUNT(DISTINCT d.ECOT_CONSECU) AS cotizaciones_distintas
FROM SISACFO.DETA_COMPRA d
JOIN SISACFO.ENCA_COMPRA e ON e.ECOM_CONSECU = d.ECOM_CONSECU
WHERE e.ECOM_FECHA >= TO_DATE('&&FECHA_CORTE','YYYY-MM-DD');

-- A3. Padres de DETA_COTIZA y de TSS_PRO_TAR_NOVEDAD (qué más arrastran)
SELECT a.table_name AS hija, ac.column_name AS col_hija, r.table_name AS padre,
       rc.column_name AS col_padre, t.num_rows AS filas_padre_aprox
FROM all_constraints a
JOIN all_cons_columns ac ON ac.owner = a.owner AND ac.constraint_name = a.constraint_name
JOIN all_constraints r   ON r.owner = a.r_owner AND r.constraint_name = a.r_constraint_name
JOIN all_cons_columns rc ON rc.owner = r.owner AND rc.constraint_name = r.constraint_name
                        AND rc.position = ac.position
LEFT JOIN all_tables t   ON t.owner = r.owner AND t.table_name = r.table_name
WHERE a.constraint_type = 'R' AND a.owner = 'SISACFO'
  AND a.table_name IN ('DETA_COTIZA','TSS_PRO_TAR_NOVEDAD')
ORDER BY a.table_name, r.table_name, ac.column_name;

-- A4. Visación: columnas sin FK (ENCA_CONSECU/DETA_LINEA con TIPO_ENCA 001, ENAP_CONSECU).
--     ¿A qué tabla apuntan realmente?
SELECT COUNT(*) AS visaciones,
       COUNT(v.ENCA_CONSECU) AS con_enca_consecu,
       COUNT(v.ENAP_CONSECU) AS con_enap,
       SUM(CASE WHEN v.ENCA_CONSECU IS NOT NULL AND EXISTS (SELECT 1 FROM SISACFO.ENCA_FACTURA x WHERE x.EFAC_CONSECU = v.ENCA_CONSECU) THEN 1 ELSE 0 END) AS coincide_factura,
       SUM(CASE WHEN v.ENCA_CONSECU IS NOT NULL AND EXISTS (SELECT 1 FROM SISACFO.ENCA_INGRESO x WHERE x.EING_CONSECU = v.ENCA_CONSECU) THEN 1 ELSE 0 END) AS coincide_ingreso,
       SUM(CASE WHEN v.ENCA_CONSECU IS NOT NULL AND EXISTS (SELECT 1 FROM SISACFO.ENCA_COMPRA  x WHERE x.ECOM_CONSECU = v.ENCA_CONSECU) THEN 1 ELSE 0 END) AS coincide_oc
FROM SISACFO.TSS_CON_VISACION v;

-- A5. Valores de COD_ITEM_PDC en DETA_FACTURA (catálogo PDC: 000, 001, 002)
SELECT COD_ITEM_PDC, COUNT(*) AS n FROM SISACFO.DETA_FACTURA GROUP BY COD_ITEM_PDC ORDER BY 1;

-- =====================================================================
-- B. CONTRATOS - ENCABEZADO
-- =====================================================================
-- B1. Conteo por la regla de alcance, con desglose (esperado total: 1.180)
SELECT c.ECON_ESTADO, NVL(e.COD_NOMBRE,'SIN CATALOGO') AS estado,
       c.ECON_TIPO,   NVL(t.COD_NOMBRE,'SIN CATALOGO') AS tipo, COUNT(*) AS n
FROM SISACFO.TSS_CON_ENCA_CONTRATO c
LEFT JOIN SISACFO.CODIGOS e ON e.COD_CODIGO = 'EPC' AND e.COD_ITEM = c.ECON_ESTADO
LEFT JOIN SISACFO.CODIGOS t ON t.COD_CODIGO = 'DTC' AND t.COD_ITEM = c.ECON_TIPO
WHERE c.ECON_FEC_VENCE >= TO_DATE('&&FECHA_CORTE','YYYY-MM-DD')
GROUP BY c.ECON_ESTADO, e.COD_NOMBRE, c.ECON_TIPO, t.COD_NOMBRE
ORDER BY 1, 3;

-- B2. Muestra de los 100 contratos más recientes con descripciones, para validar.
--     ECON_OBJETO es LONG: se une al final para no usarlo dentro de la vista en línea.
SELECT t.*, c.ECON_OBJETO
FROM (
  SELECT c.ECON_CONSECU, c.ECON_NUMERO, c.ECON_CONSECU_DE, c.ECON_NRO_OTRO_SI, c.ECON_TIPO_OTRO_SI,
         c.ECON_ESTADO,  NVL(ce.COD_NOMBRE,'SIN CATALOGO (' || c.ECON_ESTADO || ')') AS ECON_ESTADO_DESC,
         c.ECON_TIPO,    NVL(ct.COD_NOMBRE,'SIN CATALOGO (' || c.ECON_TIPO   || ')') AS ECON_TIPO_DESC,
         c.ECON_TIPO_DOCU, c.ETIP_TIPO, c.ETIP_TIPO2, c.ETIP_TIPO3, c.ECON_CLASE,
         c.PROV_DOCUMENTO, p.PROV_NOMBRE,
         TO_CHAR(c.ECON_FEC_EXPED,   'YYYY-MM-DD') AS ECON_FEC_EXPED,
         TO_CHAR(c.ECON_FEC_INICI,   'YYYY-MM-DD') AS ECON_FEC_INICI_VISACION,
         TO_CHAR(c.ECON_FEC_INI_CONT,'YYYY-MM-DD') AS ECON_FEC_INI_VIGENCIA,
         TO_CHAR(c.ECON_FEC_VENCE,   'YYYY-MM-DD') AS ECON_FEC_VENCE,
         c.ECON_FORMA_PAGO, NVL(cf.COD_NOMBRE,'SIN CATALOGO (' || c.ECON_FORMA_PAGO || ')') AS ECON_FORMA_PAGO_DESC,
         c.ECON_TIPO_CUANTIA,  CASE c.ECON_TIPO_CUANTIA  WHEN '001' THEN 'DETERMINADA'  WHEN '002' THEN 'INDETERMINADA' END AS ECON_TIPO_CUANTIA_DESC,
         c.ECON_TIPO_RECAUDO,  CASE c.ECON_TIPO_RECAUDO  WHEN '001' THEN 'FACTURA'      WHEN '002' THEN 'ORDENES DE COBRO' END AS ECON_TIPO_RECAUDO_DESC,
         c.ECON_TIPO_RECAUDO_TIMBRE, CASE c.ECON_TIPO_RECAUDO_TIMBRE WHEN '001' THEN 'FACTURA' WHEN '002' THEN 'ORDENES DE COBRO' END AS ECON_RECAUDO_TIMBRE_DESC,
         c.ECON_TIPO_PROCEDENCIA, CASE c.ECON_TIPO_PROCEDENCIA WHEN '001' THEN 'AUTOMATICA' WHEN '002' THEN 'NORMAL' WHEN '003' THEN 'ALTA' END AS ECON_PROCEDENCIA_DESC,
         c.ECON_TIPO_GASTO,   CASE c.ECON_TIPO_GASTO   WHEN 'A' THEN 'AMORTIZABLE' WHEN 'N' THEN 'SE LLEVA AL GASTO' END AS ECON_TIPO_GASTO_DESC,
         c.ECON_PROVISION,    CASE c.ECON_PROVISION    WHEN 'S' THEN 'CON PROVISION' WHEN 'N' THEN 'SIN PROVISION' END AS ECON_PROVISION_DESC,
         c.ECON_CONTROL_EJEC, c.ECON_CAUSACION,
         c.EMPR_CONSECU, em.EMPR_NOMBRE,
         c.REGI_CONSECU, rg.REGI_NOMBRE,
         c.CC1_CODIGO, c.CC2_CODIGO, c.CC3_CODIGO, c.CC4_CODIGO, cv.NOMBRE AS CENTRO_COSTO_NOMBRE,
         c.ENT_CODIGO, en.ENT_NOMBRE,
         c.EMP_CODIGO_SUPER, sp.EMP_NOMBRE_COMPLETO AS SUPERVISOR_NOMBRE,
         c.PAI_CODIGO, c.DEP_CODIGO, c.MUN_CODIGO,
         c.ECON_USER, TO_CHAR(c.ECON_SYSDATE,'YYYY-MM-DD HH24:MI:SS') AS ECON_SYSDATE
  FROM SISACFO.TSS_CON_ENCA_CONTRATO c
  LEFT JOIN SISACFO.PROVEEDOR p  ON p.PROV_DOCUMENTO = c.PROV_DOCUMENTO
  LEFT JOIN SISACFO.CODIGOS ce   ON ce.COD_CODIGO = 'EPC' AND ce.COD_ITEM = c.ECON_ESTADO
  LEFT JOIN SISACFO.CODIGOS ct   ON ct.COD_CODIGO = 'DTC' AND ct.COD_ITEM = c.ECON_TIPO
  LEFT JOIN SISACFO.CODIGOS cf   ON cf.COD_CODIGO = 'TFP' AND cf.COD_ITEM = c.ECON_FORMA_PAGO
  LEFT JOIN SISACFO.EMPRESAS em  ON em.EMPR_CONSECU = c.EMPR_CONSECU
  LEFT JOIN SISACFO.REGIONAL rg  ON rg.REGI_CONSECU = c.REGI_CONSECU AND rg.EMPR_CONSECU = c.EMPR_CONSECU
  LEFT JOIN SISACFO.CENTROS_VI cv ON cv.EMPR_CONSECU = c.EMPR_CONSECU AND cv.REGI_CONSECU = c.REGI_CONSECU
                                 AND cv.CC1_CODIGO = c.CC1_CODIGO AND cv.CC2_CODIGO = c.CC2_CODIGO
                                 AND cv.CC3_CODIGO = c.CC3_CODIGO AND cv.CC4_CODIGO = c.CC4_CODIGO
  LEFT JOIN SISACFO.ENTE en      ON en.EMPR_CONSECU = c.EMPR_CONSECU AND en.ENT_CODIGO = c.ENT_CODIGO
  LEFT JOIN SISACFO.EMPLEADO sp  ON sp.EMP_CODIGO = c.EMP_CODIGO_SUPER
  WHERE c.ECON_FEC_VENCE >= TO_DATE('&&FECHA_CORTE','YYYY-MM-DD')
  ORDER BY c.ECON_FEC_EXPED DESC, c.ECON_CONSECU DESC
  FETCH FIRST 100 ROWS ONLY
) t
JOIN SISACFO.TSS_CON_ENCA_CONTRATO c ON c.ECON_CONSECU = t.ECON_CONSECU
ORDER BY t.ECON_FEC_EXPED DESC, t.ECON_CONSECU DESC;

-- B3. Control: los joins de la muestra no multiplican filas (deben ser iguales)
SELECT (SELECT COUNT(*) FROM SISACFO.TSS_CON_ENCA_CONTRATO
         WHERE ECON_FEC_VENCE >= TO_DATE('&&FECHA_CORTE','YYYY-MM-DD')) AS filas_contrato,
       (SELECT COUNT(*)
          FROM SISACFO.TSS_CON_ENCA_CONTRATO c
          LEFT JOIN SISACFO.PROVEEDOR p   ON p.PROV_DOCUMENTO = c.PROV_DOCUMENTO
          LEFT JOIN SISACFO.EMPRESAS em   ON em.EMPR_CONSECU = c.EMPR_CONSECU
          LEFT JOIN SISACFO.REGIONAL rg   ON rg.REGI_CONSECU = c.REGI_CONSECU AND rg.EMPR_CONSECU = c.EMPR_CONSECU
          LEFT JOIN SISACFO.CENTROS_VI cv ON cv.EMPR_CONSECU = c.EMPR_CONSECU AND cv.REGI_CONSECU = c.REGI_CONSECU
                                         AND cv.CC1_CODIGO = c.CC1_CODIGO AND cv.CC2_CODIGO = c.CC2_CODIGO
                                         AND cv.CC3_CODIGO = c.CC3_CODIGO AND cv.CC4_CODIGO = c.CC4_CODIGO
          LEFT JOIN SISACFO.ENTE en       ON en.EMPR_CONSECU = c.EMPR_CONSECU AND en.ENT_CODIGO = c.ENT_CODIGO
          LEFT JOIN SISACFO.EMPLEADO sp   ON sp.EMP_CODIGO = c.EMP_CODIGO_SUPER
         WHERE c.ECON_FEC_VENCE >= TO_DATE('&&FECHA_CORTE','YYYY-MM-DD')) AS filas_con_join
FROM dual;

-- B4. Control: referencias que no resuelven en la muestra completa de alcance (esperado 0 salvo
--     centro de costo, que puede quedar sin nombre si algún nivel viene NULL)
SELECT SUM(CASE WHEN p.PROV_DOCUMENTO IS NULL THEN 1 ELSE 0 END)                         AS sin_proveedor,
       SUM(CASE WHEN em.EMPR_CONSECU  IS NULL THEN 1 ELSE 0 END)                         AS sin_empresa,
       SUM(CASE WHEN c.REGI_CONSECU IS NOT NULL AND rg.REGI_CONSECU IS NULL THEN 1 ELSE 0 END) AS sin_regional,
       SUM(CASE WHEN en.ENT_CODIGO IS NULL THEN 1 ELSE 0 END)                            AS sin_ente,
       SUM(CASE WHEN c.EMP_CODIGO_SUPER IS NOT NULL AND sp.EMP_CODIGO IS NULL THEN 1 ELSE 0 END) AS sin_supervisor,
       SUM(CASE WHEN cv.CC4_CODIGO IS NULL THEN 1 ELSE 0 END)                            AS sin_centro_costo
FROM SISACFO.TSS_CON_ENCA_CONTRATO c
LEFT JOIN SISACFO.PROVEEDOR p   ON p.PROV_DOCUMENTO = c.PROV_DOCUMENTO
LEFT JOIN SISACFO.EMPRESAS em   ON em.EMPR_CONSECU = c.EMPR_CONSECU
LEFT JOIN SISACFO.REGIONAL rg   ON rg.REGI_CONSECU = c.REGI_CONSECU AND rg.EMPR_CONSECU = c.EMPR_CONSECU
LEFT JOIN SISACFO.CENTROS_VI cv ON cv.EMPR_CONSECU = c.EMPR_CONSECU AND cv.REGI_CONSECU = c.REGI_CONSECU
                               AND cv.CC1_CODIGO = c.CC1_CODIGO AND cv.CC2_CODIGO = c.CC2_CODIGO
                               AND cv.CC3_CODIGO = c.CC3_CODIGO AND cv.CC4_CODIGO = c.CC4_CODIGO
LEFT JOIN SISACFO.ENTE en       ON en.EMPR_CONSECU = c.EMPR_CONSECU AND en.ENT_CODIGO = c.ENT_CODIGO
LEFT JOIN SISACFO.EMPLEADO sp   ON sp.EMP_CODIGO = c.EMP_CODIGO_SUPER
WHERE c.ECON_FEC_VENCE >= TO_DATE('&&FECHA_CORTE','YYYY-MM-DD');

-- =====================================================================
-- C. CONTRATOS - EXTRACCIÓN (misma regla de alcance en todas las tablas hijas)
--    ECON_OBJETO es LONG: en el cliente use SET LONG 2000000 (SQL*Plus) o la
--    exportación de SQL Developer; para copiar a otra base use TO_LOB en un CREATE TABLE AS.
-- =====================================================================
-- C1. Encabezado
SELECT c.* FROM SISACFO.TSS_CON_ENCA_CONTRATO c
WHERE c.ECON_FEC_VENCE >= TO_DATE('&&FECHA_CORTE','YYYY-MM-DD')
ORDER BY c.ECON_CONSECU;

-- C2. Hijas directas (reemplace la tabla; todas se filtran por ECON_CONSECU del alcance)
--     TSS_CON_ARRI_CONTRATO, TSS_CON_ESTADO_CONTRATO, TSS_CON_VLR_CONTRATO,
--     TSS_CON_CLAUSULA, TSS_CON_INCREMENTO_CONTRATO, TSS_CON_VLR_ESTIMADO,
--     TSS_CON_EJECUCION, TSS_CON_VISACION
SELECT h.* FROM SISACFO.TSS_CON_ARRI_CONTRATO h
WHERE h.ECON_CONSECU IN (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO
                         WHERE ECON_FEC_VENCE >= TO_DATE('&&FECHA_CORTE','YYYY-MM-DD'))
ORDER BY h.ECON_CONSECU, h.ARCO_LINEA;

-- C3. Histórico REG (solo contratos en alcance; excluye de hecho los 171 de contratos eliminados)
--     TSS_CON_ENCA_CONTRATO_REG, TSS_CON_ARRI_CONTRATO_REG, TSS_CON_ESTADO_CONTRATO_REG,
--     TSS_CON_VLR_CONTRATO_REG, TSS_CON_DETA_REGISTRO (mismo filtro por ECON_CONSECU)
SELECT r.* FROM SISACFO.TSS_CON_ENCA_CONTRATO_REG r
WHERE r.ECON_CONSECU IN (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO
                         WHERE ECON_FEC_VENCE >= TO_DATE('&&FECHA_CORTE','YYYY-MM-DD'))
ORDER BY r.ECON_CONSECU, r.ECON_LINEA;

-- C4. Cuadre: filas esperadas por tabla bajo la regla (guárdelas para validar el destino)
WITH s AS (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO
           WHERE ECON_FEC_VENCE >= TO_DATE('&&FECHA_CORTE','YYYY-MM-DD'))
SELECT 'TSS_CON_ENCA_CONTRATO' AS tabla, COUNT(*) AS filas FROM s
UNION ALL SELECT 'TSS_CON_ARRI_CONTRATO',        COUNT(*) FROM SISACFO.TSS_CON_ARRI_CONTRATO        WHERE ECON_CONSECU IN (SELECT ECON_CONSECU FROM s)
UNION ALL SELECT 'TSS_CON_ESTADO_CONTRATO',      COUNT(*) FROM SISACFO.TSS_CON_ESTADO_CONTRATO      WHERE ECON_CONSECU IN (SELECT ECON_CONSECU FROM s)
UNION ALL SELECT 'TSS_CON_VLR_CONTRATO',         COUNT(*) FROM SISACFO.TSS_CON_VLR_CONTRATO         WHERE ECON_CONSECU IN (SELECT ECON_CONSECU FROM s)
UNION ALL SELECT 'TSS_CON_CLAUSULA',             COUNT(*) FROM SISACFO.TSS_CON_CLAUSULA             WHERE ECON_CONSECU IN (SELECT ECON_CONSECU FROM s)
UNION ALL SELECT 'TSS_CON_INCREMENTO_CONTRATO',  COUNT(*) FROM SISACFO.TSS_CON_INCREMENTO_CONTRATO  WHERE ECON_CONSECU IN (SELECT ECON_CONSECU FROM s)
UNION ALL SELECT 'TSS_CON_VLR_ESTIMADO',         COUNT(*) FROM SISACFO.TSS_CON_VLR_ESTIMADO         WHERE ECON_CONSECU IN (SELECT ECON_CONSECU FROM s)
UNION ALL SELECT 'TSS_CON_EJECUCION',            COUNT(*) FROM SISACFO.TSS_CON_EJECUCION            WHERE ECON_CONSECU IN (SELECT ECON_CONSECU FROM s)
UNION ALL SELECT 'TSS_CON_VISACION',             COUNT(*) FROM SISACFO.TSS_CON_VISACION             WHERE ECON_CONSECU IN (SELECT ECON_CONSECU FROM s)
UNION ALL SELECT 'TSS_CON_ENCA_CONTRATO_REG',    COUNT(*) FROM SISACFO.TSS_CON_ENCA_CONTRATO_REG    WHERE ECON_CONSECU IN (SELECT ECON_CONSECU FROM s)
UNION ALL SELECT 'TSS_CON_ARRI_CONTRATO_REG',    COUNT(*) FROM SISACFO.TSS_CON_ARRI_CONTRATO_REG    WHERE ECON_CONSECU IN (SELECT ECON_CONSECU FROM s)
UNION ALL SELECT 'TSS_CON_ESTADO_CONTRATO_REG',  COUNT(*) FROM SISACFO.TSS_CON_ESTADO_CONTRATO_REG  WHERE ECON_CONSECU IN (SELECT ECON_CONSECU FROM s)
UNION ALL SELECT 'TSS_CON_VLR_CONTRATO_REG',     COUNT(*) FROM SISACFO.TSS_CON_VLR_CONTRATO_REG     WHERE ECON_CONSECU IN (SELECT ECON_CONSECU FROM s)
UNION ALL SELECT 'TSS_CON_DETA_REGISTRO',        COUNT(*) FROM SISACFO.TSS_CON_DETA_REGISTRO        WHERE ECON_CONSECU IN (SELECT ECON_CONSECU FROM s);
