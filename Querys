-- ---------------------------------------------------------------------
-- 2. Padres de las columnas transversales (empresa, regional, centros de
--    costo, ente, moneda, empleado): descubre el nombre real de cada tabla
-- ---------------------------------------------------------------------
SELECT DISTINCT ac.column_name AS col_hija, r.table_name AS padre, rc.column_name AS col_padre
FROM all_constraints a
JOIN all_cons_columns ac ON ac.owner = a.owner AND ac.constraint_name = a.constraint_name
JOIN all_constraints r   ON r.owner = a.r_owner AND r.constraint_name = a.r_constraint_name
JOIN all_cons_columns rc ON rc.owner = r.owner AND rc.constraint_name = r.constraint_name
                        AND rc.position = ac.position
WHERE a.constraint_type = 'R' AND a.owner = 'SISACFO'
  AND ac.column_name IN ('EMPR_CONSECU','REGI_CONSECU','CC1_CODIGO','CC2_CODIGO','CC3_CODIGO',
                         'CC4_CODIGO','ENT_CODIGO','MON_CONSECU','EMP_CODIGO','TASA_LINEA')
ORDER BY 1, 2;

