-- P1. PROV_BENEFI: distribución y prueba de "inicial del nombre".
--     Si min_nom y max_nom empiezan con la misma letra del valor, es un
--     índice alfabético del nombre y no un catálogo.
SELECT PROV_BENEFI, COUNT(*) AS n,
       MIN(PROV_NOMBRE) AS min_nom, MAX(PROV_NOMBRE) AS max_nom
FROM SISACFO.PROVEEDOR
GROUP BY PROV_BENEFI
ORDER BY n DESC;

-- P2. PROV_CHEQUEO, PROV_TIPO y PROV_ENDOSO: valores reales
SELECT 'PROV_CHEQUEO' AS campo, TO_CHAR(PROV_CHEQUEO) AS valor, COUNT(*) AS n FROM SISACFO.PROVEEDOR GROUP BY PROV_CHEQUEO
UNION ALL SELECT 'PROV_TIPO',   TO_CHAR(PROV_TIPO),   COUNT(*) FROM SISACFO.PROVEEDOR GROUP BY PROV_TIPO
UNION ALL SELECT 'PROV_ENDOSO', TO_CHAR(PROV_ENDOSO), COUNT(*) FROM SISACFO.PROVEEDOR GROUP BY PROV_ENDOSO
ORDER BY 1, 2;

-- P3. ¿El código de la aplicación (triggers, paquetes, vistas) los explica?
SELECT name, type, line, TRIM(text) AS texto
FROM all_source
WHERE owner = 'SISACFO'
  AND ( UPPER(text) LIKE '%PROV_BENEFI%'
     OR UPPER(text) LIKE '%PROV_CHEQUEO%'
     OR UPPER(text) LIKE '%PROV_ENDOSO%' )
ORDER BY name, type, line;

