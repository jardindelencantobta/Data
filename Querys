FROM (SELECT ECOT_CONSECU FROM SISACFO.DETA_COMPRA WHERE ECOT_CONSECU IS NOT NULL AND ECOM_CONSECU IN (SELECT ECOM_CONSECU FROM SISACFO.ENCA_COMPRA WHERE ECOM_FECHA >= DATE '2016-11-18' UNION SELECT ECOM_CONSECU FROM SISACFO.ENCA_FACTURA WHERE ECOM_CONSECU IS NOT NULL AND EFAC_CONSECU IN (SELECT EFAC_CONSECU FROM SISACFO.ENCA_FACTURA WHERE ECON_CONSECU IN (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_FEC_VENCE >= DATE '2016-11-18') OR EFAC_FECHA >= DATE '2016-11-18' UNION SELECT EFAC_CONSECU FROM SISACFO.TSS_CON_EJECUCION WHERE EFAC_CONSECU IS NOT NULL AND ECON_CONSECU IN (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_FEC_VENCE >= DATE '2016-11-18') UNION SELECT EFAC_CONSECU FROM SISACFO.TSS_CON_VISACION WHERE EFAC_CONSECU IS NOT NULL AND ECON_CONSECU IN (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_FEC_VENCE >= DATE '2016-11-18')) UNION SELECT ECOM_CONSECU FROM SISACFO.DETA_FACTURA WHERE ECOM_CONSECU IS NOT NULL AND EFAC_CONSECU IN (SELECT EFAC_CONSECU FROM SISACFO.ENCA_FACTURA WHERE ECON_CONSECU IN (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_FEC_VENCE >= DATE '2016-11-18') OR EFAC_FECHA >= DATE '2016-11-18' UNION SELECT EFAC_CONSECU FROM SISACFO.TSS_CON_EJECUCION WHERE EFAC_CONSECU IS NOT NULL AND ECON_CONSECU IN (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_FEC_VENCE >= DATE '2016-11-18') UNION SELECT EFAC_CONSECU FROM SISACFO.TSS_CON_VISACION WHERE EFAC_CONSECU IS NOT NULL AND ECON_CONSECU IN (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_FEC_VENCE >= DATE '2016-11-18')) UNION SELECT ECOM_CONSECU FROM SISACFO.DETA_INGRESO WHERE ECOM_CONSECU IS NOT NULL AND EING_CONSECU IN (SELECT EING_CONSECU FROM SISACFO.ENCA_INGRESO WHERE EING_FECHA >= DATE '2016-11-18') UNION SELECT ECOM_CONSECU FROM SISACFO.TSS_ORDENES_ING_DIRECTOS WHERE EING_CONSECU IN (SELECT EING_CONSECU FROM SISACFO.ENCA_INGRESO WHERE EING_FECHA >= DATE '2016-11-18'))) s
WHERE NOT EXISTS (SELECT 1 FROM SISACFO.ENCA_COTIZA k WHERE k.ECOT_CONSECU = s.ECOT_CONSECU)
UNION ALL
SELECT 'visacion con pedido inexistente', COUNT(*)
FROM SISACFO.TSS_CON_VISACION v
WHERE v.ENCA_CONSECU IS NOT NULL AND v.ECON_CONSECU IN (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_FEC_VENCE >= DATE '2016-11-18')
  AND NOT EXISTS (SELECT 1 FROM SISACFO.ENCA_PEDIDO x WHERE x.EREQ_CONSECU = v.ENCA_CONSECU)
UNION ALL
SELECT 'contratos con proveedor inexistente', COUNT(*)
FROM SISACFO.TSS_CON_ENCA_CONTRATO c
WHERE c.ECON_CONSECU IN (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_FEC_VENCE >= DATE '2016-11-18')
  AND NOT EXISTS (SELECT 1 FROM SISACFO.PROVEEDOR p WHERE p.PROV_DOCUMENTO = c.PROV_DOCUMENTO)
UNION ALL
SELECT 'facturas con proveedor inexistente', COUNT(*)
FROM SISACFO.ENCA_FACTURA f
WHERE f.EFAC_CONSECU IN (SELECT EFAC_CONSECU FROM SISACFO.ENCA_FACTURA WHERE ECON_CONSECU IN (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_FEC_VENCE >= DATE '2016-11-18') OR EFAC_FECHA >= DATE '2016-11-18' UNION SELECT EFAC_CONSECU FROM SISACFO.TSS_CON_EJECUCION WHERE EFAC_CONSECU IS NOT NULL AND ECON_CONSECU IN (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_FEC_VENCE >= DATE '2016-11-18') UNION SELECT EFAC_CONSECU FROM SISACFO.TSS_CON_VISACION WHERE EFAC_CONSECU IS NOT NULL AND ECON_CONSECU IN (SELECT ECON_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO WHERE ECON_FEC_VENCE >= DATE '2016-11-18'))
  AND NOT EXISTS (SELECT 1 FROM SISACFO.PROVEEDOR p WHERE p.PROV_DOCUMENTO = f.PROV_DOCUMENTO);

-- =====================================================================
-- 5. PADRES DE LAS TABLAS NUEVAS (única verificación de metadatos que queda):
--    confirma que no arrastran más tablas de las ya incluidas
-- =====================================================================
SELECT a.table_name AS hija, r.table_name AS padre, LISTAGG(ac.column_name, ',') WITHIN GROUP (ORDER BY ac.position) AS cols
FROM all_constraints a
JOIN all_cons_columns ac ON ac.owner = a.owner AND ac.constraint_name = a.constraint_name
JOIN all_constraints r   ON r.owner = a.r_owner AND r.constraint_name = a.r_constraint_name
WHERE a.constraint_type = 'R' AND a.owner = 'SISACFO'
  AND a.table_name IN ('ENCA_COTIZA','ENCA_PEDIDO','DETA_PEDIDO','TSS_OUT_ENCA_APROBACION','TSS_PRO_TAR_NOVEDAD',
                       'TSS_PRO_TAR_CENTRO','TSS_PRO_TAR_CLIENTE','TSS_PRO_TAR_PRODUCTO','TSS_PRO_TAR_PROV',
                       'TSS_PRO_TAR_RECARGO','TSS_PRO_TAR_SERV_CLIENTE','TSS_PRO_TAR_UBICACION','TSS_PRO_TAR_VOLUMEN')
GROUP BY a.table_name, r.table_name, a.constraint_name
ORDER BY 1, 2;
