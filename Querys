-- =====================================================================
-- SISACFO - Migración SISA - Ronda 3
-- Alcance de contratos, valores de columnas codificadas y estructura
-- de las tablas hijas que sí tienen datos
-- =====================================================================

-- ---------------------------------------------------------------------
-- 1. Cuántos contratos entran según cada regla candidata
-- ---------------------------------------------------------------------
SELECT COUNT(*) AS total,
       SUM(CASE WHEN ECON_ESTADO <> '003' THEN 1 ELSE 0 END)                           AS no_terminados,
       SUM(CASE WHEN ECON_FEC_VENCE >= ADD_MONTHS(SYSDATE,-120) THEN 1 ELSE 0 END)     AS solo_por_vence,
       SUM(CASE WHEN ECON_ESTADO <> '003'
                  OR ECON_FEC_VENCE >= ADD_MONTHS(SYSDATE,-120) THEN 1 ELSE 0 END)    AS no_terminado_o_vence
FROM SISACFO.TSS_CON_ENCA_CONTRATO;

-- ---------------------------------------------------------------------
-- 2. Alcance con cierre hacia arriba (contratos de origen, ECON_CONSECU_DE):
--    cuántos contratos quedan al traer los ancestros de los que entran
-- ---------------------------------------------------------------------
SELECT COUNT(DISTINCT ECON_CONSECU) AS contratos_con_ancestros
FROM SISACFO.TSS_CON_ENCA_CONTRATO
START WITH (ECON_ESTADO <> '003' OR ECON_FEC_VENCE >= ADD_MONTHS(SYSDATE,-120))
CONNECT BY NOCYCLE PRIOR ECON_CONSECU_DE = ECON_CONSECU;

-- ---------------------------------------------------------------------
-- 3. OC, ingresos y facturas: volumen por fecha de negocio y por vínculo
--    con contrato (las que no tienen contrato se alcanzan solo por fecha)
-- ---------------------------------------------------------------------
SELECT 'ENCA_COMPRA' AS tabla, COUNT(*) AS total,
       SUM(CASE WHEN ECOM_FECHA >= ADD_MONTHS(SYSDATE,-120) THEN 1 ELSE 0 END) AS ultimos_10,
       SUM(CASE WHEN ECON_CONSECU IS NOT NULL THEN 1 ELSE 0 END)               AS con_contrato
FROM SISACFO.ENCA_COMPRA
UNION ALL
SELECT 'ENCA_INGRESO', COUNT(*),
       SUM(CASE WHEN EING_FECHA >= ADD_MONTHS(SYSDATE,-120) THEN 1 ELSE 0 END),
       SUM(CASE WHEN ECON_CONSECU IS NOT NULL THEN 1 ELSE 0 END)
FROM SISACFO.ENCA_INGRESO
UNION ALL
SELECT 'ENCA_FACTURA', COUNT(*),
       SUM(CASE WHEN EFAC_FECHA >= ADD_MONTHS(SYSDATE,-120) THEN 1 ELSE 0 END),
       SUM(CASE WHEN ECON_CONSECU IS NOT NULL THEN 1 ELSE 0 END)
FROM SISACFO.ENCA_FACTURA;

-- ---------------------------------------------------------------------
-- 4. Valores reales (con nulos) de las columnas codificadas
--    Necesario porque en columnas de 1 a 3 valores casi cualquier grupo
--    de CODIGOS "cubre" los valores y el método anterior no discrimina.
-- ---------------------------------------------------------------------
SELECT 'ECON_TIPO' AS col, TO_CHAR(ECON_TIPO) AS valor, COUNT(*) AS n FROM SISACFO.TSS_CON_ENCA_CONTRATO GROUP BY ECON_TIPO
UNION ALL SELECT 'ECON_TIPO_RECAUDO',        TO_CHAR(ECON_TIPO_RECAUDO),        COUNT(*) FROM SISACFO.TSS_CON_ENCA_CONTRATO GROUP BY ECON_TIPO_RECAUDO
UNION ALL SELECT 'ECON_TIPO_RECAUDO_TIMBRE', TO_CHAR(ECON_TIPO_RECAUDO_TIMBRE), COUNT(*) FROM SISACFO.TSS_CON_ENCA_CONTRATO GROUP BY ECON_TIPO_RECAUDO_TIMBRE
UNION ALL SELECT 'ECON_TIPO_CUANTIA',        TO_CHAR(ECON_TIPO_CUANTIA),        COUNT(*) FROM SISACFO.TSS_CON_ENCA_CONTRATO GROUP BY ECON_TIPO_CUANTIA
UNION ALL SELECT 'ECON_TIPO_PROCEDENCIA',    TO_CHAR(ECON_TIPO_PROCEDENCIA),    COUNT(*) FROM SISACFO.TSS_CON_ENCA_CONTRATO GROUP BY ECON_TIPO_PROCEDENCIA
UNION ALL SELECT 'ECON_TIPO_OTRO_SI',        TO_CHAR(ECON_TIPO_OTRO_SI),        COUNT(*) FROM SISACFO.TSS_CON_ENCA_CONTRATO GROUP BY ECON_TIPO_OTRO_SI
UNION ALL SELECT 'ECON_TIPO_DOCU',           TO_CHAR(ECON_TIPO_DOCU),           COUNT(*) FROM SISACFO.TSS_CON_ENCA_CONTRATO GROUP BY ECON_TIPO_DOCU
UNION ALL SELECT 'ECON_CLASE',               TO_CHAR(ECON_CLASE),               COUNT(*) FROM SISACFO.TSS_CON_ENCA_CONTRATO GROUP BY ECON_CLASE
UNION ALL SELECT 'ECON_TIPO_COMITE',         TO_CHAR(ECON_TIPO_COMITE),         COUNT(*) FROM SISACFO.TSS_CON_ENCA_CONTRATO GROUP BY ECON_TIPO_COMITE
UNION ALL SELECT 'MNT_CODIGO',               TO_CHAR(MNT_CODIGO),               COUNT(*) FROM SISACFO.TSS_CON_ENCA_CONTRATO GROUP BY MNT_CODIGO
UNION ALL SELECT 'TIPO_PROV',                TO_CHAR(TIPO_PROV),                COUNT(*) FROM SISACFO.TSS_CON_ENCA_CONTRATO GROUP BY TIPO_PROV
UNION ALL SELECT 'ETIP_TIPO',                TO_CHAR(ETIP_TIPO),                COUNT(*) FROM SISACFO.TSS_CON_ENCA_CONTRATO GROUP BY ETIP_TIPO
UNION ALL SELECT 'ETIP_TIPO2',               TO_CHAR(ETIP_TIPO2),               COUNT(*) FROM SISACFO.TSS_CON_ENCA_CONTRATO GROUP BY ETIP_TIPO2
UNION ALL SELECT 'ETIP_TIPO3',               TO_CHAR(ETIP_TIPO3),               COUNT(*) FROM SISACFO.TSS_CON_ENCA_CONTRATO GROUP BY ETIP_TIPO3
UNION ALL SELECT 'ECOM_ESTADO',              TO_CHAR(ECOM_ESTADO),              COUNT(*) FROM SISACFO.ENCA_COMPRA GROUP BY ECOM_ESTADO
UNION ALL SELECT 'ECOM_TIPO',                TO_CHAR(ECOM_TIPO),                COUNT(*) FROM SISACFO.ENCA_COMPRA GROUP BY ECOM_TIPO
UNION ALL SELECT 'EING_TIPO',                TO_CHAR(EING_TIPO),                COUNT(*) FROM SISACFO.ENCA_INGRESO GROUP BY EING_TIPO
UNION ALL SELECT 'EFAC_ESTADO',              TO_CHAR(EFAC_ESTADO),              COUNT(*) FROM SISACFO.ENCA_FACTURA GROUP BY EFAC_ESTADO
UNION ALL SELECT 'EFAC_TIPO',                TO_CHAR(EFAC_TIPO),                COUNT(*) FROM SISACFO.ENCA_FACTURA GROUP BY EFAC_TIPO
UNION ALL SELECT 'EFAC_ORIGEN',              TO_CHAR(EFAC_ORIGEN),              COUNT(*) FROM SISACFO.ENCA_FACTURA GROUP BY EFAC_ORIGEN
ORDER BY 1, 2;

-- ---------------------------------------------------------------------
-- 5. Los códigos de una letra de OC, ingresos y facturas NO están en
--    CODIGOS. ¿Los explica el código de la base (paquetes, triggers) o
--    los comentarios del diccionario?
-- ---------------------------------------------------------------------
SELECT name, type, COUNT(*) AS lineas
FROM all_source
WHERE owner = 'SISACFO'
  AND ( UPPER(text) LIKE '%ECOM_ESTADO%' OR UPPER(text) LIKE '%ECOM_TIPO%'
     OR UPPER(text) LIKE '%EING_TIPO%'   OR UPPER(text) LIKE '%EFAC_ESTADO%'
     OR UPPER(text) LIKE '%EFAC_TIPO%'   OR UPPER(text) LIKE '%EFAC_ORIGEN%' )
GROUP BY name, type
ORDER BY lineas DESC;

SELECT table_name, column_name, comments
FROM all_col_comments
WHERE owner = 'SISACFO'
  AND comments IS NOT NULL
  AND ( (table_name = 'ENCA_COMPRA'  AND column_name IN ('ECOM_ESTADO','ECOM_TIPO'))
     OR (table_name = 'ENCA_INGRESO' AND column_name IN ('EING_TIPO','EING_ESTADO'))
     OR (table_name = 'ENCA_FACTURA' AND column_name IN ('EFAC_ESTADO','EFAC_TIPO','EFAC_ORIGEN'))
     OR (table_name = 'TSS_CON_ENCA_CONTRATO'
         AND column_name IN ('ECON_TIPO_RECAUDO','ECON_TIPO_RECAUDO_TIMBRE','ECON_TIPO_CUANTIA',
                             'ECON_TIPO_PROCEDENCIA','ECON_TIPO_OTRO_SI','ECON_CLASE','ECON_TIPO_COMITE')) );

-- ---------------------------------------------------------------------
-- 6. Histórico: filas de TSS_CON_DETA_REGISTRO sin versión en
--    TSS_CON_ENCA_CONTRATO_REG (19.329 contra 19.325)
-- ---------------------------------------------------------------------
SELECT COUNT(*) AS deta_sin_version
FROM SISACFO.TSS_CON_DETA_REGISTRO d
WHERE NOT EXISTS (SELECT 1 FROM SISACFO.TSS_CON_ENCA_CONTRATO_REG r
                  WHERE r.ECON_CONSECU = d.ECON_CONSECU AND r.ECON_LINEA = d.ECON_LINEA);

-- ---------------------------------------------------------------------
-- 7. Estructura de las tablas hijas que SÍ tienen datos
--    (columnas, PK y FK hacia padres)
-- ---------------------------------------------------------------------
SELECT table_name, column_id, column_name, data_type, data_length, nullable
FROM all_tab_columns
WHERE owner = 'SISACFO'
  AND table_name IN ('TSS_CON_DETA_REGISTRO','DETA_PEDIDO','TSS_CON_INCREMENTO_CONTRATO',
                     'TSS_CON_VLR_ESTIMADO','TSS_CON_CLAUSULA','TSS_OUT_ENCA_APROBACION',
                     'TSS_MAN_DOCUMENTO','DETA_FACTURA','TSS_PAG_ADEL_EFAC','DETA_INGRESO',
                     'DETA_COMPRA','TSS_ORD_APROB_COMPRA','TSS_ORD_DETA_REQUISITOS',
                     'TSS_ORDENES_ING_DIRECTOS')
ORDER BY table_name, column_id;

SELECT c.table_name, c.constraint_type, c.constraint_name, cc.column_name, cc.position
FROM all_constraints c
JOIN all_cons_columns cc ON cc.owner = c.owner AND cc.constraint_name = c.constraint_name
WHERE c.owner = 'SISACFO' AND c.constraint_type IN ('P','U')
  AND c.table_name IN ('TSS_CON_DETA_REGISTRO','DETA_PEDIDO','TSS_CON_INCREMENTO_CONTRATO',
                       'TSS_CON_VLR_ESTIMADO','TSS_CON_CLAUSULA','TSS_OUT_ENCA_APROBACION',
                       'TSS_MAN_DOCUMENTO','DETA_FACTURA','TSS_PAG_ADEL_EFAC','DETA_INGRESO',
                       'DETA_COMPRA','TSS_ORD_APROB_COMPRA','TSS_ORD_DETA_REQUISITOS',
                       'TSS_ORDENES_ING_DIRECTOS')
ORDER BY c.table_name, c.constraint_name, cc.position;

SELECT a.table_name AS hija, ac.column_name AS col_hija,
       r.table_name AS padre, rc.column_name AS col_padre, a.constraint_name
FROM all_constraints a
JOIN all_cons_columns ac ON ac.owner = a.owner AND ac.constraint_name = a.constraint_name
JOIN all_constraints r   ON r.owner = a.r_owner AND r.constraint_name = a.r_constraint_name
JOIN all_cons_columns rc ON rc.owner = r.owner AND rc.constraint_name = r.constraint_name
                        AND rc.position = ac.position
WHERE a.constraint_type = 'R' AND a.owner = 'SISACFO'
  AND a.table_name IN ('TSS_CON_DETA_REGISTRO','DETA_PEDIDO','TSS_CON_INCREMENTO_CONTRATO',
                       'TSS_CON_VLR_ESTIMADO','TSS_CON_CLAUSULA','TSS_OUT_ENCA_APROBACION',
                       'TSS_MAN_DOCUMENTO','DETA_FACTURA','TSS_PAG_ADEL_EFAC','DETA_INGRESO',
                       'DETA_COMPRA','TSS_ORD_APROB_COMPRA','TSS_ORD_DETA_REQUISITOS',
                       'TSS_ORDENES_ING_DIRECTOS')
ORDER BY a.table_name, a.constraint_name, ac.position;
