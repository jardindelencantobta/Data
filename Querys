-- =====================================================================
-- SISACFO - Archivo 13: cierre de las 4 dependencias abiertas tras el 12
-- Solo conteos y metadatos (rápido). Pegue el resultado debajo de cada bloque.
-- =====================================================================
DEFINE FECHA_CORTE = 2016-11-18

-- 1. Centro de costo: el join por CC1..CC4 no resolvió ningún contrato (1.181 sin nombre).
--    1a. ¿Vienen nulos los CC1..CC4 del contrato? 1b. ¿Resuelve por ECON_CENTRO_CODIGO?
SELECT COUNT(*) AS contratos, COUNT(c.CC1_CODIGO) AS cc1_no_nulo, COUNT(c.CC4_CODIGO) AS cc4_no_nulo,
       COUNT(c.ECON_CENTRO_CODIGO) AS centro_codigo_no_nulo,
       SUM(CASE WHEN cv.CENTRO_CODIGO IS NOT NULL THEN 1 ELSE 0 END) AS resuelve_por_centro_codigo
FROM SISACFO.TSS_CON_ENCA_CONTRATO c
LEFT JOIN SISACFO.CENTROS_VI cv ON cv.CENTRO_CODIGO = c.ECON_CENTRO_CODIGO
WHERE c.ECON_FEC_VENCE >= TO_DATE('&&FECHA_CORTE','YYYY-MM-DD');

SELECT c.ECON_CENTRO_CODIGO, c.EMPR_CONSECU, c.REGI_CONSECU, c.CC1_CODIGO, c.CC2_CODIGO, c.CC3_CODIGO, c.CC4_CODIGO, COUNT(*) AS n
FROM SISACFO.TSS_CON_ENCA_CONTRATO c
WHERE c.ECON_FEC_VENCE >= TO_DATE('&&FECHA_CORTE','YYYY-MM-DD')
GROUP BY c.ECON_CENTRO_CODIGO, c.EMPR_CONSECU, c.REGI_CONSECU, c.CC1_CODIGO, c.CC2_CODIGO, c.CC3_CODIGO, c.CC4_CODIGO
ORDER BY n DESC FETCH FIRST 15 ROWS ONLY;

SELECT COUNT(*) AS filas_centros_vi, COUNT(DISTINCT CENTRO_CODIGO) AS codigos_distintos FROM SISACFO.CENTROS_VI;

-- 2. Visación -> pedidos / aprobaciones de outsourcing (columnas sin FK)
SELECT COUNT(v.ENCA_CONSECU) AS con_enca_consecu,
       SUM(CASE WHEN EXISTS (SELECT 1 FROM SISACFO.ENCA_PEDIDO x WHERE x.EREQ_CONSECU = v.ENCA_CONSECU) THEN 1 ELSE 0 END) AS coincide_pedido,
       SUM(CASE WHEN EXISTS (SELECT 1 FROM SISACFO.DETA_PEDIDO x WHERE x.EREQ_CONSECU = v.ENCA_CONSECU AND x.DREQ_LINEA = v.DETA_LINEA) THEN 1 ELSE 0 END) AS coincide_pedido_linea,
       COUNT(v.ENAP_CONSECU) AS con_enap,
       SUM(CASE WHEN EXISTS (SELECT 1 FROM SISACFO.TSS_OUT_ENCA_APROBACION x WHERE x.ENAP_CONSECU = v.ENAP_CONSECU) THEN 1 ELSE 0 END) AS enap_existe
FROM SISACFO.TSS_CON_VISACION v;

-- 3. Cotizaciones: ¿qué tablas llevan ECOT_CONSECU (cabecera de cotización)? y TNOV_CONSECU (tarifas)?
SELECT column_name, table_name FROM all_tab_columns
WHERE owner = 'SISACFO' AND column_name IN ('ECOT_CONSECU','TNOV_CONSECU')
ORDER BY column_name, table_name;

-- 4. Volumen a traer por cierre
--    4a. Líneas de cotización referenciadas por OC en alcance
SELECT COUNT(*) AS lineas_cotiza_a_traer
FROM SISACFO.DETA_COTIZA k
WHERE EXISTS (SELECT 1 FROM SISACFO.DETA_COMPRA d JOIN SISACFO.ENCA_COMPRA e ON e.ECOM_CONSECU = d.ECOM_CONSECU
              WHERE e.ECOM_FECHA >= TO_DATE('&&FECHA_CORTE','YYYY-MM-DD')
                AND d.ECOT_CONSECU = k.ECOT_CONSECU AND d.DCOT_LINEA = k.DCOT_LINEA);
--    4b. Novedades de tarifa referenciadas por contratos en alcance, incluida su cadena base
SELECT COUNT(DISTINCT TNOV_CONSECU) AS novedades_a_traer
FROM SISACFO.TSS_PRO_TAR_NOVEDAD
START WITH TNOV_CONSECU IN (SELECT TNOV_CONSECU FROM SISACFO.TSS_CON_ENCA_CONTRATO
                            WHERE ECON_FEC_VENCE >= TO_DATE('&&FECHA_CORTE','YYYY-MM-DD') AND TNOV_CONSECU IS NOT NULL)
CONNECT BY NOCYCLE PRIOR TNOV_CONSECU_BASE = TNOV_CONSECU;
