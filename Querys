-- 2. Visación -> pedidos / aprobaciones de outsourcing (columnas sin FK)
SELECT COUNT(v.ENCA_CONSECU) AS con_enca_consecu,
       SUM(CASE WHEN EXISTS (SELECT 1 FROM SISACFO.ENCA_PEDIDO x WHERE x.EREQ_CONSECU = v.ENCA_CONSECU) THEN 1 ELSE 0 END) AS coincide_pedido,
       SUM(CASE WHEN EXISTS (SELECT 1 FROM SISACFO.DETA_PEDIDO x WHERE x.EREQ_CONSECU = v.ENCA_CONSECU AND x.DREQ_LINEA = v.DETA_LINEA) THEN 1 ELSE 0 END) AS coincide_pedido_linea,
       COUNT(v.ENAP_CONSECU) AS con_enap,
       SUM(CASE WHEN EXISTS (SELECT 1 FROM SISACFO.TSS_OUT_ENCA_APROBACION x WHERE x.ENAP_CONSECU = v.ENAP_CONSECU) THEN 1 ELSE 0 END) AS enap_existe
FROM SISACFO.TSS_CON_VISACION v;

