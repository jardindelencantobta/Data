-- =====================================================================
-- SISACFO - Migración SISA - MOVIMIENTOS DE PROVEEDOR (TSS_PRO_MOVIMIENTO)
-- Consulta final. Se migra COMPLETA (sigue a PROVEEDOR, que va completo).
-- Estructura (7 columnas): PROV_DOCUMENTO, PROM_LINEA (PK), PROM_TIPO,
-- PROM_FECHA, PROM_FECHA_USUARIO, PROM_OBSERVACION, PROM_USUARIO.
-- =====================================================================

-- 1. Conteo real (esperado: 12.915 = 1.911 + 7.484 + 3.520)
SELECT COUNT(*) AS filas_reales,
       COUNT(DISTINCT PROV_DOCUMENTO) AS proveedores_con_movimientos,
       MIN(PROM_FECHA) AS fecha_min, MAX(PROM_FECHA) AS fecha_max
FROM SISACFO.TSS_PRO_MOVIMIENTO;

-- 2. Muestra de los 100 más recientes, con descripciones, para el usuario final
SELECT M.PROV_DOCUMENTO,
       P.PROV_NOMBRE,
       M.PROM_LINEA,
       M.PROM_TIPO,
       NVL(C.COD_NOMBRE, 'SIN CATALOGO (' || M.PROM_TIPO || ')') AS PROM_TIPO_DESC,
       M.PROM_FECHA,
       M.PROM_FECHA_USUARIO,
       M.PROM_USUARIO,
       M.PROM_OBSERVACION
FROM SISACFO.TSS_PRO_MOVIMIENTO M
LEFT JOIN SISACFO.PROVEEDOR P ON P.PROV_DOCUMENTO = M.PROV_DOCUMENTO
LEFT JOIN SISACFO.CODIGOS   C ON C.COD_CODIGO = 'MPR' AND C.COD_ITEM = M.PROM_TIPO
ORDER BY M.PROM_FECHA DESC NULLS LAST, M.PROV_DOCUMENTO, M.PROM_LINEA
FETCH FIRST 100 ROWS ONLY;

-- 3. Control: el join no multiplica filas (deben ser iguales)
SELECT (SELECT COUNT(*) FROM SISACFO.TSS_PRO_MOVIMIENTO) AS filas_movimiento,
       (SELECT COUNT(*)
          FROM SISACFO.TSS_PRO_MOVIMIENTO M
          LEFT JOIN SISACFO.PROVEEDOR P ON P.PROV_DOCUMENTO = M.PROV_DOCUMENTO
          LEFT JOIN SISACFO.CODIGOS   C ON C.COD_CODIGO = 'MPR' AND C.COD_ITEM = M.PROM_TIPO) AS filas_con_join
FROM dual;

-- 4. Control: movimientos sin proveedor (esperado 0)
SELECT COUNT(*) AS huerfanos
FROM SISACFO.TSS_PRO_MOVIMIENTO M
WHERE NOT EXISTS (SELECT 1 FROM SISACFO.PROVEEDOR P WHERE P.PROV_DOCUMENTO = M.PROV_DOCUMENTO);

-- 5. PROM_TIPO = 003 no está en el grupo MPR: 20 ejemplos recientes con su
--    observación para que un usuario funcional diga qué significa
SELECT PROV_DOCUMENTO, PROM_LINEA, PROM_TIPO, PROM_FECHA, PROM_USUARIO, PROM_OBSERVACION
FROM SISACFO.TSS_PRO_MOVIMIENTO
WHERE PROM_TIPO = '003'
ORDER BY PROM_FECHA DESC NULLS LAST
FETCH FIRST 20 ROWS ONLY;

-- 6. PROM_TIPO 003: ¿qué observaciones se repiten y desde cuándo existen?
SELECT PROM_TIPO,
       SUBSTR(PROM_OBSERVACION, 1, 60) AS observacion_inicio,
       COUNT(*) AS n, MIN(PROM_FECHA) AS desde, MAX(PROM_FECHA) AS hasta
FROM SISACFO.TSS_PRO_MOVIMIENTO
GROUP BY PROM_TIPO, SUBSTR(PROM_OBSERVACION, 1, 60)
HAVING COUNT(*) >= 20
ORDER BY PROM_TIPO, n DESC;

-- =====================================================================
-- 7. EXTRACCIÓN FINAL (fechas con formato explícito: el cliente las
--    mostraba con año de 2 dígitos, ej. 05/10/10)
-- =====================================================================
SELECT M.PROV_DOCUMENTO,
       M.PROM_LINEA,
       M.PROM_TIPO,
       TO_CHAR(M.PROM_FECHA,         'YYYY-MM-DD HH24:MI:SS') AS PROM_FECHA,
       TO_CHAR(M.PROM_FECHA_USUARIO, 'YYYY-MM-DD HH24:MI:SS') AS PROM_FECHA_USUARIO,
       M.PROM_USUARIO,
       M.PROM_OBSERVACION
FROM SISACFO.TSS_PRO_MOVIMIENTO M
ORDER BY M.PROV_DOCUMENTO, M.PROM_LINEA;

-- =====================================================================
-- 8. Verificaciones que quedan abiertas (una sola corrida)
-- =====================================================================
-- 8a. Usuarios por tipo de movimiento (¿003 lo registra otro perfil?)
SELECT PROM_TIPO, PROM_USUARIO, COUNT(*) AS n
FROM SISACFO.TSS_PRO_MOVIMIENTO
GROUP BY PROM_TIPO, PROM_USUARIO
ORDER BY PROM_TIPO, n DESC;

-- 8b. ¿Cada 003 va seguido de un 002 en la línea siguiente del mismo proveedor?
SELECT COUNT(*) AS movimientos_003,
       SUM(CASE WHEN EXISTS (SELECT 1 FROM SISACFO.TSS_PRO_MOVIMIENTO X
                             WHERE X.PROV_DOCUMENTO = M.PROV_DOCUMENTO
                               AND X.PROM_LINEA = M.PROM_LINEA + 1
                               AND X.PROM_TIPO = '002') THEN 1 ELSE 0 END) AS seguidos_de_002
FROM SISACFO.TSS_PRO_MOVIMIENTO M
WHERE M.PROM_TIPO = '003';

-- 8c. Fecha de usuario distinta a la del movimiento, o nulos
SELECT SUM(CASE WHEN PROM_FECHA <> PROM_FECHA_USUARIO THEN 1 ELSE 0 END) AS fechas_distintas,
       SUM(CASE WHEN PROM_FECHA_USUARIO IS NULL THEN 1 ELSE 0 END)       AS usuario_nulo,
       SUM(CASE WHEN PROM_OBSERVACION IS NULL THEN 1 ELSE 0 END)         AS obs_nula
FROM SISACFO.TSS_PRO_MOVIMIENTO;

-- 8d. El último movimiento es de 01/03/2017: ¿PROVEEDOR se siguió actualizando después?
SELECT MAX(PROV_FECHA_ACTUALIZA) AS ultima_actualizacion_proveedor,
       MAX(PROV_SYSDATE)         AS ultimo_alta_proveedor
FROM SISACFO.PROVEEDOR;

-- 8e. ¿PROV_NOMBRE está limitado a 40 caracteres en origen? (se vieron nombres cortados)
SELECT column_name, data_type, data_length
FROM all_tab_columns
WHERE owner = 'SISACFO' AND table_name = 'PROVEEDOR' AND column_name = 'PROV_NOMBRE';
