-- =====================================================================
-- SISACFO - PROVEEDOR - Muestra de los 100 registros más recientes
-- para validación del usuario final.
-- Cambios frente a la versión original:
--   * TP.COD_CODIGO calificado y movido al ON del join (evita ambigüedad
--     y mantiene el LEFT JOIN como outer real)
--   * ORDER BY con NULLS LAST (en Oracle, DESC pone los NULL primero) y
--     desempate por PROV_DOCUMENTO para que el resultado sea repetible
--   * Campo FECHA_REFERENCIA para que el usuario vea por qué entró cada fila
-- =====================================================================
SELECT
       P.PROV_DOCUMENTO,
       P.PROV_TIPO_DOC,
       TP.COD_NOMBRE,
       P.PROV_NOMBRE,
       P.PROV_REP_NOMBRE,
       P.PROV_REP_APE1,
       P.PROV_REP_APE2,
       P.PROV_CONT_NOMBRE,
       P.PROV_CONT_APE1,
       P.PROV_CONT_APE2,
       P.PROV_REGISTRO,
       P.PROV_CLASE,
       P.PROV_DIRECCION,
       P.PROV_FAX,
       P.PROV_TRIBUTA,
       P.PROV_ESTADO,
       P.PROV_ULT_COMPRA,
       P.PROV_VENCE,
       P.DEP_CODIGO,
       P.MUN_CODIGO,
       P.PROV_CHEQUEO,
       P.PROV_DEDICA,
       P.PROV_BENEFI,
       P.PROV_SIGLA,
       P.PROV_A_A_NRO,
       P.PROV_FE_I_REGIS,
       P.PROV_FE_F_REGIS,
       P.DEP_CODIGO_REGIS,
       P.MUN_CODIGO_REGIS,
       P.PROV_NOTARIA_REGIS,
       P.DEP_CODIGO_NOTA,
       P.MUN_CODIGO_NOTA,
       P.PROV_ESCRITURA_NUM,
       P.PROV_FE_F_SOCIEDAD,
       P.PROV_MONTO_MAX,
       P.PROV_CAPITAL_PAGADO,
       P.PROV_AVALUA,
       P.PRETI_CODIGO,
       P.PAI_CODIGO,
       P.PAI_CODIGO_REGIS,
       P.PAI_CODIGO_NOTA,
       P.PROV_TIPO_NEGOCIO,
       P.PROV_NRO_REF,
       P.PROV_FEC_ULT_REF,
       P.PROV_NOTA_REF,
       P.PROV_PAI,
       P.PROV_DEP,
       P.PROV_MUN,
       P.PROV_FEC_ULT_CAMP,
       P.PROV_MOT_REF,
       P.PROV_ATR_REF,
       P.PROV_ATR_VAL_REP,
       P.PROV_ACT_LIM_REP,
       P.PROV_VAL_ACT_REP,
       P.PROV_VAL_ACTIVOS,
       P.PROV_FEC_ACTIVOS,
       P.PROV_VAL_INGRESOS,
       P.PROV_FEC_INGRESOS,
       P.COD_PROV_DED,
       P.PROV_CUENTA,
       P.PROV_BANCO,
       P.PROV_NRO_REFS,
       P.PROV_CARGA,
       P.PROV_REP_PAI,
       P.PROV_REP_DEP,
       P.PROV_REP_MUN,
       P.PROV_REP_TEL,
       P.PROV_REP_FAX,
       P.PROV_TIPO,
       P.PROV_PAGO_AUT,
       P.PROV_SAP,
       P.ENT_CODIGO,
       P.PROV_TERMINAL,
       P.PROV_USUARIO,
       P.PROV_SYSDATE,
       P.PROV_BASE,
       P.PROV_WEB_SITE,
       P.PROV_EMAIL,
       P.PROV_TIPO_ENTIDAD,
       P.PROV_GRUPO_ECONOMICO,
       P.PROV_SOCIEDAD,
       P.PROV_NATURALEZA_JURIDICA,
       P.PROV_DECLARA,
       P.PROV_TIPDOC_OTRO,
       P.PROV_TIPO_PAGO,
       P.EMPR_CONSECU_COLOCACION,
       P.REGI_CONSECU_COLOCACION,
       P.CC1_CODIGO_COLOCACION,
       P.CC2_CODIGO_COLOCACION,
       P.CC3_CODIGO_COLOCACION,
       P.CC4_CODIGO_COLOCACION,
       P.PROV_DOMICILIO,
       P.PROV_EFAC_CONSECU,
       P.PROV_CARPETA,
       P.EMPR_CONSECU_CARPETA,
       P.REGI_CONSECU_CARPETA,
       P.CC1_CODIGO_CARPETA,
       P.CC2_CODIGO_CARPETA,
       P.CC3_CODIGO_CARPETA,
       P.CC4_CODIGO_CARPETA,
       P.PROV_OBS_DOCU,
       P.PROV_ACT_DOCU,
       P.PROV_FECHA_ACTUALIZA,
       P.PROV_FEC_F_CAMARA,
       P.PROV_TAXID,
       P.PROV_TIPO_PERSONA,
       P.PROV_TRIBUTA_CREE,
       P.ACRE_CONSECU,
       P.PROV_DECLARA_INGRESO_INFERIOR,
       P.PROV_EMPLEADO,
       P.PROV_ZONA_FRANCA,
       P.PROV_INDICA_CERT_INDEP,
       P.PROV_SERVICIO_PERSONAL,
       P.PROV_CENTRO_CODIGO_CAR,
       P.PROV_CENTRO_CODIGO_COL,
       P.PROV_ENDOSO,
       P.PROV_INDICA_PERS_VINC,
       PA.PAI_NOMBRE      AS PAIS_DESCRIPCION,
       D.DEP_NOMBRE       AS DEPARTAMENTO_DESCRIPCION,
       M.MUN_NOMBRE       AS MUNICIPIO_DESCRIPCION,
       PR.PRETI_NOMBRE    AS RETENCION_IVA_DESCRIPCION,
       PR.PRETI_PCT       AS RETENCION_IVA_PORCENTAJE,
       PR.PRETI_APLICA    AS RETENCION_IVA_APLICA,
       PR.PRETI_RETICA    AS RETENCION_IVA_RETICA,
       AC.ACRE_CODIGO     AS ACTIVIDAD_CREE_CODIGO,
       AC.ACRE_CONCEPTO   AS ACTIVIDAD_CREE_DESCRIPCION,
       NVL(P.PROV_FECHA_ACTUALIZA, P.PROV_SYSDATE) AS FECHA_REFERENCIA
FROM SISACFO.PROVEEDOR P
LEFT OUTER JOIN SISACFO.PAIS PA
       ON PA.PAI_CODIGO = P.PAI_CODIGO
LEFT OUTER JOIN SISACFO.DEPTOS D
       ON D.PAI_CODIGO = P.PAI_CODIGO
      AND D.DEP_CODIGO = P.DEP_CODIGO
LEFT OUTER JOIN SISACFO.MUNICIPIOS M
       ON M.PAI_CODIGO = P.PAI_CODIGO
      AND M.DEP_CODIGO = P.DEP_CODIGO
      AND M.MUN_CODIGO = P.MUN_CODIGO
LEFT OUTER JOIN SISACFO.PROV_RET_IVA PR
       ON PR.PRETI_CODIGO = P.PRETI_CODIGO
LEFT OUTER JOIN SISACFO.TSS_IMP_ACTI_CREE AC
       ON AC.ACRE_CONSECU = P.ACRE_CONSECU
LEFT OUTER JOIN SISACFO.CODIGOS TP
       ON TP.COD_CODIGO = 'TDI'
      AND TP.COD_ITEM   = P.PROV_TIPO_DOC
ORDER BY NVL(P.PROV_FECHA_ACTUALIZA, P.PROV_SYSDATE) DESC NULLS LAST,
         P.PROV_DOCUMENTO
FETCH FIRST 100 ROWS ONLY;

-- ---------------------------------------------------------------------
-- Control: los joins no deben multiplicar filas.
-- Ambos conteos deben ser iguales. Si difieren, algún catálogo tiene
-- más de una fila por llave y la muestra saldría con duplicados.
-- ---------------------------------------------------------------------
SELECT
  (SELECT COUNT(*) FROM SISACFO.PROVEEDOR) AS filas_proveedor,
  (SELECT COUNT(*)
     FROM SISACFO.PROVEEDOR P
     LEFT OUTER JOIN SISACFO.PAIS PA ON PA.PAI_CODIGO = P.PAI_CODIGO
     LEFT OUTER JOIN SISACFO.DEPTOS D ON D.PAI_CODIGO = P.PAI_CODIGO AND D.DEP_CODIGO = P.DEP_CODIGO
     LEFT OUTER JOIN SISACFO.MUNICIPIOS M ON M.PAI_CODIGO = P.PAI_CODIGO AND M.DEP_CODIGO = P.DEP_CODIGO AND M.MUN_CODIGO = P.MUN_CODIGO
     LEFT OUTER JOIN SISACFO.PROV_RET_IVA PR ON PR.PRETI_CODIGO = P.PRETI_CODIGO
     LEFT OUTER JOIN SISACFO.TSS_IMP_ACTI_CREE AC ON AC.ACRE_CONSECU = P.ACRE_CONSECU
     LEFT OUTER JOIN SISACFO.CODIGOS TP ON TP.COD_CODIGO = 'TDI' AND TP.COD_ITEM = P.PROV_TIPO_DOC
  ) AS filas_con_joins
FROM dual;
