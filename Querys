-- =====================================================================
-- SISACFO - Migración SISA - Ronda 3 (complemento)
-- Cierra lo que falta para escribir las consultas finales de todos los
-- dominios: catálogos completos, catálogos transversales y valores reales.
-- =====================================================================

-- ---------------------------------------------------------------------
-- 1. CODIGOS completo de los grupos usados (el volcado anterior estaba
--    filtrado por ítem y no traía 003, 007, 009 a 013, etc.)
-- ---------------------------------------------------------------------
SELECT COD_CODIGO, COD_ITEM, COD_NOMBRE
FROM SISACFO.CODIGOS
WHERE COD_CODIGO IN ('TDI','EPR','DIP','TNP','PAG','TDN','TEP','GRP','TSP','TNJ',
                     'DTC','EPC','ESC','TFP','MPR')
ORDER BY COD_CODIGO, COD_ITEM;

-- ---------------------------------------------------------------------
-- 2. Padres de las columnas transversales (empresa, regional, centros de
--    costo, ente, moneda, empleado): descubre el nombre real de cada tabla
-- ---------------------------------------------------------------------
SELECT DISTINCT ac.column_name AS col_hija, r.table_name AS padre, rc.column_name AS col_padre
FROM all_constraints a
JOIN all_cons_columns ac ON ac.owner = a.owner AND ac.constraint_name = a.constraint_name
JOIN all_constraints r   ON r.owner = a.r_owner AND r.constraint_name = a.r_constraint_name
JOIN all_cons_columns rc ON rc.owner = r.owner AND rc.constraint_name = r.constraint_name
                        AND rc.position = ac.position
WHERE a.constraint_type = 'R' AND a.owner = 'SISACFO'
  AND ac.column_name IN ('EMPR_CONSECU','REGI_CONSECU','CC1_CODIGO','CC2_CODIGO','CC3_CODIGO',
                         'CC4_CODIGO','ENT_CODIGO','MON_CONSECU','EMP_CODIGO','TASA_LINEA')
ORDER BY 1, 2;

-- ---------------------------------------------------------------------
-- 3. Columnas de las tablas de apoyo (para decodificar nombres)
-- ---------------------------------------------------------------------
SELECT table_name, column_id, column_name, data_type, data_length
FROM all_tab_columns
WHERE owner = 'SISACFO'
  AND ( table_name IN ('ENTE','TSS_MAN_TASA','TSS_MAN_PERIODOS','TSS_PRO_TAR_NOVEDAD',
                       'TSS_IVA_DESCONTABLE','PRODUCTO','RETENCION','IVA','TIMBRE',
                       'TSS_IMP_CONSUMO','UNIDAD','TAPA','TSS_RAD_RADICACION','TSS_TARJE_CREDITO')
     OR table_name LIKE 'EMPRESA%'  OR table_name LIKE 'REGION%'
     OR table_name LIKE 'CENTRO%'   OR table_name LIKE 'MONEDA%'
     OR table_name LIKE 'EMPLEADO%' OR table_name LIKE 'TSS_MAN_MONEDA%' )
ORDER BY table_name, column_id;

-- ---------------------------------------------------------------------
-- 4. Valores reales de otras columnas codificadas (con nulos)
-- ---------------------------------------------------------------------
SELECT 'TSS_PRO_MOVIMIENTO.PROM_TIPO' AS col, TO_CHAR(PROM_TIPO) AS valor, COUNT(*) AS n FROM SISACFO.TSS_PRO_MOVIMIENTO GROUP BY PROM_TIPO
UNION ALL SELECT 'TSS_CON_VISACION.CVIS_AUTORIZA',         TO_CHAR(CVIS_AUTORIZA),         COUNT(*) FROM SISACFO.TSS_CON_VISACION GROUP BY CVIS_AUTORIZA
UNION ALL SELECT 'TSS_CON_VISACION.TIPO_ENCA',             TO_CHAR(TIPO_ENCA),             COUNT(*) FROM SISACFO.TSS_CON_VISACION GROUP BY TIPO_ENCA
UNION ALL SELECT 'TSS_CON_VISACION.INCO_TIPO',             TO_CHAR(INCO_TIPO),             COUNT(*) FROM SISACFO.TSS_CON_VISACION GROUP BY INCO_TIPO
UNION ALL SELECT 'TSS_CON_VISACION.CVIS_FORMA_TIPO',       TO_CHAR(CVIS_FORMA_TIPO),       COUNT(*) FROM SISACFO.TSS_CON_VISACION GROUP BY CVIS_FORMA_TIPO
UNION ALL SELECT 'TSS_CON_VISACION.CVIS_INDICA_SUSTITUTO', TO_CHAR(CVIS_INDICA_SUSTITUTO), COUNT(*) FROM SISACFO.TSS_CON_VISACION GROUP BY CVIS_INDICA_SUSTITUTO
UNION ALL SELECT 'TSS_CON_VISACION.CVIS_VARIACION_AUT',    TO_CHAR(CVIS_VARIACION_AUT),    COUNT(*) FROM SISACFO.TSS_CON_VISACION GROUP BY CVIS_VARIACION_AUT
UNION ALL SELECT 'TSS_CON_EJECUCION.EJEC_CODIGO',          TO_CHAR(EJEC_CODIGO),           COUNT(*) FROM SISACFO.TSS_CON_EJECUCION GROUP BY EJEC_CODIGO
UNION ALL SELECT 'TSS_CON_EJECUCION.INCO_TIPO',            TO_CHAR(INCO_TIPO),             COUNT(*) FROM SISACFO.TSS_CON_EJECUCION GROUP BY INCO_TIPO
UNION ALL SELECT 'TSS_CON_EJECUCION.EJEC_VISADO',          TO_CHAR(EJEC_VISADO),           COUNT(*) FROM SISACFO.TSS_CON_EJECUCION GROUP BY EJEC_VISADO
UNION ALL SELECT 'TSS_CON_EJECUCION.EJEC_COSTO_ADICIONAL', TO_CHAR(EJEC_COSTO_ADICIONAL),  COUNT(*) FROM SISACFO.TSS_CON_EJECUCION GROUP BY EJEC_COSTO_ADICIONAL
UNION ALL SELECT 'TSS_CON_ARRI_CONTRATO.ARCO_FORMA_PAGO',  TO_CHAR(ARCO_FORMA_PAGO),       COUNT(*) FROM SISACFO.TSS_CON_ARRI_CONTRATO GROUP BY ARCO_FORMA_PAGO
UNION ALL SELECT 'TSS_CON_ARRI_CONTRATO.ARCO_DESCTO_TIPO', TO_CHAR(ARCO_DESCTO_TIPO),      COUNT(*) FROM SISACFO.TSS_CON_ARRI_CONTRATO GROUP BY ARCO_DESCTO_TIPO
UNION ALL SELECT 'TSS_CON_ARRI_CONTRATO.ARCO_PROV_TRIBUTA',TO_CHAR(ARCO_PROV_TRIBUTA),     COUNT(*) FROM SISACFO.TSS_CON_ARRI_CONTRATO GROUP BY ARCO_PROV_TRIBUTA
UNION ALL SELECT 'ENCA_FACTURA.EFAC_TIPO_PROV',            TO_CHAR(EFAC_TIPO_PROV),        COUNT(*) FROM SISACFO.ENCA_FACTURA GROUP BY EFAC_TIPO_PROV
UNION ALL SELECT 'ENCA_FACTURA.COD_ITEM_PDF',              TO_CHAR(COD_ITEM_PDF),          COUNT(*) FROM SISACFO.ENCA_FACTURA GROUP BY COD_ITEM_PDF
UNION ALL SELECT 'ENCA_COMPRA.TPAR_CONSECU',               TO_CHAR(TPAR_CONSECU),          COUNT(*) FROM SISACFO.ENCA_COMPRA GROUP BY TPAR_CONSECU
ORDER BY 1, 2;
