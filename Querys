-- ---------------------------------------------------------------------
-- 3. Relaciones SIN foreign key: huérfanos (todos deberían dar 0)
-- ---------------------------------------------------------------------
SELECT 'CONTRATO -> PROVEEDOR' AS relacion, COUNT(*) AS huerfanos
FROM SISACFO.TSS_CON_ENCA_CONTRATO c
WHERE NOT EXISTS (SELECT 1 FROM SISACFO.PROVEEDOR p WHERE p.PROV_DOCUMENTO = c.PROV_DOCUMENTO)
UNION ALL
SELECT 'FACTURA -> PROVEEDOR', COUNT(*)
FROM SISACFO.ENCA_FACTURA f
WHERE f.PROV_DOCUMENTO IS NOT NULL
  AND NOT EXISTS (SELECT 1 FROM SISACFO.PROVEEDOR p WHERE p.PROV_DOCUMENTO = f.PROV_DOCUMENTO)
UNION ALL
SELECT 'FACTURA -> OC (ECOM_CONSECU)', COUNT(*)
FROM SISACFO.ENCA_FACTURA f
WHERE f.ECOM_CONSECU IS NOT NULL
  AND NOT EXISTS (SELECT 1 FROM SISACFO.ENCA_COMPRA o WHERE o.ECOM_CONSECU = f.ECOM_CONSECU)
UNION ALL
SELECT 'OC -> CONTRATO', COUNT(*)
FROM SISACFO.ENCA_COMPRA o
WHERE o.ECON_CONSECU IS NOT NULL
  AND NOT EXISTS (SELECT 1 FROM SISACFO.TSS_CON_ENCA_CONTRATO c WHERE c.ECON_CONSECU = o.ECON_CONSECU)
UNION ALL
SELECT 'INGRESO -> CONTRATO', COUNT(*)
FROM SISACFO.ENCA_INGRESO i
WHERE i.ECON_CONSECU IS NOT NULL
  AND NOT EXISTS (SELECT 1 FROM SISACFO.TSS_CON_ENCA_CONTRATO c WHERE c.ECON_CONSECU = i.ECON_CONSECU)
UNION ALL
SELECT 'ENCA_CONTRATO_REG -> CONTRATO vivo (filas)', COUNT(*)
FROM SISACFO.TSS_CON_ENCA_CONTRATO_REG r
WHERE NOT EXISTS (SELECT 1 FROM SISACFO.TSS_CON_ENCA_CONTRATO c WHERE c.ECON_CONSECU = r.ECON_CONSECU)
UNION ALL
SELECT 'ENCA_CONTRATO_REG -> CONTRATO vivo (contratos)', COUNT(DISTINCT r.ECON_CONSECU)
FROM SISACFO.TSS_CON_ENCA_CONTRATO_REG r
WHERE NOT EXISTS (SELECT 1 FROM SISACFO.TSS_CON_ENCA_CONTRATO c WHERE c.ECON_CONSECU = r.ECON_CONSECU);

