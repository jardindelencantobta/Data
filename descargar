def carpeta_documentos() -> Path:
    """Devuelve la carpeta 'Mis documentos' del usuario (Windows, con o sin OneDrive)."""
    if os.name == "nt":
        try:
            import ctypes
            from ctypes import wintypes

            buf = ctypes.create_unicode_buffer(wintypes.MAX_PATH)
            # CSIDL_PERSONAL = 5 -> "Mis documentos" real (respeta redirección a OneDrive)
            ctypes.windll.shell32.SHGetFolderPathW(None, 5, None, 0, buf)
            if buf.value:
                return Path(buf.value)
        except Exception:
            pass
    return Path.home() / "Documents"


def leer_tickets(ruta: Path) -> list:
    """Lee los números de ticket de un archivo (acepta una lista con comillas/comas)."""
    texto = ruta.read_text(encoding="utf-8")
    tickets = re.findall(r"\d{6,}", texto)
    vistos, unicos = set(), []
    for t in tickets:
        if t not in vistos:
            vistos.add(t)
            unicos.append(t)
    return unicos


def nombre_seguro(nombre: str) -> str:
    nombre = re.sub(r'[<>:"/\\|?*\x00-\x1f]', "_", nombre).strip(" .")
    return nombre or "adjunto"


def nombre_desde_cabecera(resp, respaldo: str) -> str:
    cd = resp.headers.get("Content-Disposition", "")
    m = re.search(r"filename\*\s*=\s*[^']*'[^']*'([^;]+)", cd, re.I)
    if m:
        return nombre_seguro(unquote(m.group(1).strip().strip('"')))
    m = re.search(r'filename\s*=\s*"?([^";]+)"?', cd, re.I)
    if m:
        crudo = m.group(1).strip()
        try:  # algunos servidores mandan UTF-8 interpretado como latin-1
            crudo = crudo.encode("latin-1").decode("utf-8")
        except (UnicodeEncodeError, UnicodeDecodeError):
            pass
        return nombre_seguro(unquote(crudo))
    return respaldo


MAX_RUTA = 240  # Windows no admite rutas de más de 260 caracteres


def nombre_para_carpeta(carpeta: Path, nombre: str) -> str:
    """Limpia el nombre y lo recorta (conservando la extensión) para que la ruta
    completa no supere el límite de Windows."""
    nombre = nombre_seguro(nombre)
    base, ext = os.path.splitext(nombre)
    if len(ext) > 15:
        base, ext = nombre, ""
    disponible = MAX_RUTA - len(str(carpeta)) - 1 - len(".part") - 4 - len(ext)
    disponible = max(disponible, 20)
    if len(base) > disponible:
        base = base[:disponible].rstrip(" .")
    return base + ext


def ruta_sin_colision(carpeta: Path, nombre: str) -> Path:
    nombre = nombre_para_carpeta(carpeta, nombre)
    destino = carpeta / nombre
    base, ext = os.path.splitext(nombre)
    n = 1
    while destino.exists():
        destino = carpeta / f"{base}_{n}{ext}"
        n += 1
    return destino


