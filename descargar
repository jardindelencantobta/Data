def leer_error_sdp(resp):
    """Extrae códigos y mensajes del JSON de error de ServiceDesk Plus."""
    codigos, mensajes = set(), []
    try:
        data = resp.json()
    except ValueError:
        return codigos, ""
    estado = data.get("response_status", {}) if isinstance(data, dict) else {}
    if isinstance(estado, list):
        estado = estado[0] if estado else {}
    if estado.get("status_code"):
        codigos.add(int(estado["status_code"]))
    for m in estado.get("messages", []) or []:
        if m.get("status_code"):
            try:
                codigos.add(int(m["status_code"]))
            except (TypeError, ValueError):
                pass
        if m.get("message"):
            mensajes.append(str(m["message"]))
    return codigos, "; ".join(mensajes)


def interpretar(resp, esperado_json=False):
    """Clasifica una respuesta. Devuelve (tipo, mensaje en español)."""
    code = resp.status_code
    ctype = resp.headers.get("Content-Type", "").lower()
    loc = resp.headers.get("Location", "").lower()

    if code in (301, 302, 303, 307, 308):
        if "login" in loc or "j_security_check" in loc or "auth" in loc:
            return "sesion", MSG_SESION
        return "otro", f"El servidor redirige a {resp.headers.get('Location')} (HTTP {code})."

    if code == 200:
        es_html = "text/html" in ctype and "Content-Disposition" not in resp.headers
        if es_html:
            return "sesion", ("El servidor devolvió una página web (posible pantalla de "
                              "inicio de sesión) en vez de datos.\n" + MSG_SESION)
        return "ok", "Respuesta correcta (HTTP 200)."

    codigos, detalle = leer_error_sdp(resp) if "json" in ctype else (set(), "")
    sufijo = f"\n  Mensaje del servidor: {detalle}" if detalle else ""
    texto = detalle.lower()

    if code == 401 or 401 in codigos or 4002 in codigos or "unauthori" in texto \
            or "session" in texto or "sesión" in texto or "login" in texto \
            or "autentic" in texto or "authentic" in texto or "token" in texto:
        return "sesion", MSG_SESION + sufijo
    if code == 403 or 7001 in codigos or "permission" in texto or "permiso" in texto:
        if not codigos and not detalle:
            # 403 sin detalle: en esta mesa de servicio suele ser sesión vencida o CSRF
            return "sesion", "El servidor rechazó la petición (HTTP 403).\n" + MSG_SESION
        return "permiso", ("Su usuario no tiene permiso para ver este ticket o adjunto. "
                           "Se omite y se continúa." + sufijo)
    if code == 404 or 4007 in codigos:
        return "no_existe", "El ticket o el adjunto no existe (HTTP 404)." + sufijo
    if code == 429 or 4015 in codigos:
        return "limite", ("El servidor está limitando la cantidad de peticiones (HTTP 429). "
                          "Vuelva a ejecutar con una pausa mayor, por ejemplo --pausa 1." + sufijo)
    if code >= 500:
        return "servidor", (f"La mesa de servicio tuvo un error interno (HTTP {code}). "
                            "Puede ser temporal: intente de nuevo en unos minutos." + sufijo)
    if code == 400:
        return "otro", ("El servidor rechazó la petición (HTTP 400). Si se repite en todos "
                        "los tickets, probablemente la sesión expiró." + sufijo)
    return "otro", f"Respuesta inesperada del servidor (HTTP {code})." + sufijo

# ----------------------------------------------------------------------------
# Cliente HTTP
# ----------------------------------------------------------------------------
class Cliente:
    def __init__(self, base_url, authtoken=None, cookie=None, verificar_ssl=True,
                 pausa=0.2, timeout=60):
        self.base = base_url.rstrip("/")
        self.pausa = pausa
        self.timeout = timeout
        self.s = requests.Session()
        self.s.verify = verificar_ssl
        reintentos = Retry(total=4, backoff_factor=1.5,
                           status_forcelist=(429, 500, 502, 503, 504),
                           allowed_methods=("GET",), raise_on_status=False)
        self.s.mount("https://", HTTPAdapter(max_retries=reintentos))
        self.s.mount("http://", HTTPAdapter(max_retries=reintentos))
        self.s.headers["User-Agent"] = ("Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                                        "AppleWebKit/537.36 (KHTML, like Gecko) "
                                        "Chrome/130.0 Safari/537.36")
        self.extra = {}          # cabeceras adicionales (CSRF) para sesión web
        self.usar_extra = True
        self._json_ok_cache = False
        self.ultimo_json_path = None  # última consulta JSON correcta (para verificar la sesión)
        self.carpeta_diag = None      # dónde guardar respuestas raras para revisarlas
        if authtoken:
            self.s.headers["authtoken"] = authtoken
        if cookie:
            cookie = re.sub(r"^\s*cookie\s*:\s*", "", cookie, flags=re.I).strip()
            self.s.headers["Cookie"] = cookie
            self.s.headers["Referer"] = self.base + "/WOListView.do"
            # ServiceDesk Plus puede pedir el token CSRF en llamadas a la API con sesión web.
            # Si el servidor lo rechaza, el script reintenta como lo hace el navegador (sin ellas).
            m = re.search(r"(?:^|;\s*)sdpcsrfcookie=([^;]+)", cookie)
            if m:
                self.extra["X-ZCSRF-TOKEN"] = f"sdpcsrfparam={m.group(1)}"
            self.extra["X-Requested-With"] = "XMLHttpRequest"

    def _pedir(self, path, headers=None, con_extra=True, **kw):
        h = dict(headers or {})
        if con_extra:
            h.update(self.extra)
        time.sleep(self.pausa)
        return self.s.get(self.base + path, headers=h, timeout=self.timeout,
                          allow_redirects=False, **kw)

    @staticmethod
    def _tipo(resp):
        if resp.status_code == 200 and "text/html" not in resp.headers.get("Content-Type", "").lower():
            return "ok", ""
        if kw_stream(resp):
            resp.content  # leer el cuerpo del error para poder interpretarlo
        return interpretar(resp)

    def _get(self, path, headers=None, permitir_html=False, **kw):
        resp = self._pedir(path, headers, con_extra=self.usar_extra and bool(self.extra), **kw)
        tipo, mensaje = self._tipo(resp)
        if tipo == "sesion" and self.usar_extra and self.extra:
            # Reintentar como el navegador: solo con la cookie
            resp.close()
            resp2 = self._pedir(path, headers, con_extra=False, **kw)
            tipo2, mensaje2 = self._tipo(resp2)
            if tipo2 != "sesion":
                self.usar_extra = False
                print("  (Aviso: el servidor acepta la cookie sin cabeceras CSRF; "
                      "se continúa en ese modo)")
                return resp2
            resp, mensaje = resp2, mensaje2
        if tipo == "sesion":
            es_html_200 = resp.status_code == 200
            if es_html_200 and self.sesion_activa() and permitir_html:
                return resp  # la sesión sirve; el problema es solo este archivo
            extra_info = self._evidencia(resp, path)
            resp.close()
            raise SesionInvalida(mensaje + extra_info)
        return resp

    def _evidencia(self, resp, path):
        """Guarda la página recibida y devuelve un texto con su título y ubicación."""
        try:
            cuerpo = resp.content or b""
        except Exception:
            cuerpo = b""
        info = f"\n  Petición: {path}  (HTTP {resp.status_code}, {resp.headers.get('Content-Type', '-')})"
        m = re.search(rb"<title[^>]*>(.*?)</title>", cuerpo, re.I | re.S)
        if m:
            titulo = m.group(1).decode("utf-8", "replace").strip()
            info += f"\n  Título de la página recibida: {titulo[:120]}"
        if self.carpeta_diag and cuerpo:
            try:
                self.carpeta_diag.mkdir(parents=True, exist_ok=True)
                ruta = self.carpeta_diag / "pagina_recibida.html"
                ruta.write_bytes(cuerpo[:300000])
                info += f"\n  Copia de la página: {ruta}"
            except Exception:
                pass
        if self.ultimo_json_path:
            info += ("\n  Nota: la consulta de datos (JSON) "
                     + ("SÍ" if self._json_ok_cache else "NO")
                     + " respondía bien justo después.")
        return info

    def sesion_activa(self):
        """Comprueba con una llamada JSON si la sesión sigue siendo válida."""
        if not self.ultimo_json_path:
            return False
        try:
            r = self._pedir(self.ultimo_json_path, {"Accept": API_ACCEPT},
                            con_extra=self.usar_extra and bool(self.extra))
            ok = (r.status_code == 200
                  and "html" not in r.headers.get("Content-Type", "").lower())
            r.close()
            self._json_ok_cache = ok
            return ok
        except requests.RequestException:
            return False

    def ticket_existe(self, ticket):
        """Devuelve (estado, mensaje). estado: True existe, False no existe, None dudoso."""
        r = self._get(f"/api/v3/requests/{ticket}", headers={"Accept": API_ACCEPT})
        tipo, mensaje = interpretar(r)
        if tipo == "ok":
            self.ultimo_json_path = f"/api/v3/requests/{ticket}"
            return True, tipo, mensaje
        if tipo == "no_existe":
            return False, tipo, mensaje
        return None, tipo, mensaje

    @staticmethod
    def _ids_de(lista):
        """Devuelve [(id, nombre, url_descarga)]."""
        ids = []
        for a in lista or []:
            if isinstance(a, dict) and a.get("id"):
                url = a.get("content_url") or a.get("download_url") or ""
                ids.append((str(a["id"]), a.get("name") or a.get("file_name") or "", url))
        return ids

    def listar_adjuntos(self, ticket):
        """Devuelve [(id, nombre)] con los adjuntos reales del ticket.
        Intenta 1) el detalle del ticket y 2) el endpoint /attachments."""
        r = self._get(f"/api/v3/requests/{ticket}", headers={"Accept": API_ACCEPT})
        tipo, mensaje = interpretar(r)
        if tipo == "no_existe":
            return []
        if tipo != "ok":
            raise RuntimeError(mensaje)
        self.ultimo_json_path = f"/api/v3/requests/{ticket}"
        try:
            req = r.json().get("request", {})
        except ValueError:
            req = {}
        if isinstance(req, dict) and "attachments" in req:
            return self._ids_de(req.get("attachments"))

        r = self._get(f"/api/v3/requests/{ticket}/attachments", headers={"Accept": API_ACCEPT})
        tipo, mensaje = interpretar(r)
        if tipo == "no_existe":
            return []
        if tipo != "ok":
            raise RuntimeError(mensaje)
        return self._ids_de(r.json().get("attachments", []))

    def _ruta_relativa(self, url):
        if not url:
            return None
        if url.startswith("http"):
            m = re.match(r"https?://[^/]+(/.*)$", url)
            return m.group(1) if m else None
        return url if url.startswith("/") else "/" + url

    def descargar(self, ticket, adjunto, carpeta: Path, url_api=None):
        """Devuelve el nombre del archivo guardado, o None si responde 404."""
        candidatas = []
        rel = self._ruta_relativa(url_api)
        if rel:
            candidatas.append(rel)
        estandar = f"/api/v3/requests/{ticket}/attachments/{adjunto}/_download"
        if estandar not in candidatas:
            candidatas.append(estandar)

        ultimo_error = None
        todos_404 = True
        for path in candidatas:
            r = self._get(path, stream=True, permitir_html=True)
            try:
                ctype = r.headers.get("Content-Type", "").lower()
                if r.status_code == 200 and "text/html" in ctype \
                        and "Content-Disposition" not in r.headers:
                    archivo = self._guardar_diagnostico(ticket, adjunto, r)
                    todos_404 = False
                    ultimo_error = ("El servidor devolvió una página web en lugar del archivo"
                                    + (f" (copia en _diagnostico\\{archivo})" if archivo else "") + ".")
                    continue
                tipo, mensaje = interpretar(r)
                if tipo == "no_existe":
                    todos_404 = todos_404 and True
                    continue
                if tipo != "ok":
                    todos_404 = False
                    ultimo_error = mensaje
                    continue
                carpeta.mkdir(parents=True, exist_ok=True)
                nombre = nombre_desde_cabecera(r, f"adjunto_{adjunto}")
                destino = ruta_sin_colision(carpeta, nombre)
                temporal = destino.with_name(destino.name + ".part")
                with open(temporal, "wb") as f:
                    for bloque in r.iter_content(chunk_size=1024 * 256):
                        if bloque:
                            f.write(bloque)
                temporal.replace(destino)
                return destino.name
            finally:
                r.close()
        if todos_404:
            return None
        raise RuntimeError(ultimo_error or "No se pudo descargar el adjunto.")

    def _guardar_diagnostico(self, ticket, adjunto, resp):
        if not self.carpeta_diag:
            return None
        try:
            self.carpeta_diag.mkdir(parents=True, exist_ok=True)
            ruta = self.carpeta_diag / f"respuesta_{ticket}_{adjunto}.html"
            ruta.write_bytes(resp.content[:200000])
            return ruta.name
        except Exception:
            return None


# ----------------------------------------------------------------------------
# Proceso principal
# ----------------------------------------------------------------------------
def procesar(cliente, tickets, id_inicial, destino_base: Path, modo, flog, estado_global):
    resumen = estado_global["resumen"]  # (ticket, estado, [archivos])
    id_actual = id_inicial

    for i, ticket in enumerate(tickets, 1):
        log(f"({i}/{len(tickets)}) Ticket {ticket}", flog)
        carpeta = destino_base / ticket
        archivos = []
        errores_adj = []

        try:
            existe, tipo_ticket, msg_ticket = cliente.ticket_existe(ticket)
        except requests.exceptions.SSLError:
            raise
        except requests.RequestException as e:
            log(f"  ERROR de red consultando ticket {ticket}: {e}", flog)
            resumen.append((ticket, f"ERROR: {e}", []))
            continue
        if existe is False:
            log(f"  Ticket {ticket} no existe. Se pasa al siguiente.", flog)
            resumen.append((ticket, "NO EXISTE", []))
            continue
        if tipo_ticket == "permiso":
            log(f"  {msg_ticket}", flog)
            resumen.append((ticket, "SIN PERMISO", []))
            continue
        if existe is None:
            log(f"  Aviso al consultar el ticket: {msg_ticket}", flog)
            log("  Se intentará descargar sus adjuntos de todas formas.", flog)

        try:
            if modo == "listado":
                ids = cliente.listar_adjuntos(ticket)
                log(f"  Adjuntos según la mesa de servicio: {len(ids)}", flog)
                for adj, nombre_api, url_api in ids:
                    if nombre_api and (carpeta / nombre_para_carpeta(carpeta, nombre_api)).exists():
                        archivos.append(nombre_para_carpeta(carpeta, nombre_api))
                        log(f"  Ya existe, se omite: {nombre_api}", flog)
                        continue
                    try:
                        nombre = cliente.descargar(ticket, adj, carpeta, url_api)
                    except (RuntimeError, OSError) as e:
                        errores_adj.append(adj)
                        log(f"  ERROR adjunto {adj} ({nombre_api}): {e}", flog)
                        continue
                    if nombre:
                        archivos.append(nombre)
                        log(f"  OK  adjunto {adj} -> {nombre}", flog)
                    else:
                        log(f"  404 adjunto {adj} (listado pero no descargable)", flog)
            else:
                while id_actual > 0:
                    nombre = cliente.descargar(ticket, id_actual, carpeta)
                    if nombre is None:
                        log(f"  404 en adjunto {id_actual}. Cambio de ticket.", flog)
                        break
                    archivos.append(nombre)
                    log(f"  OK  adjunto {id_actual} -> {nombre}", flog)
                    id_actual -= 1
                    estado_global["id_actual"] = id_actual
        except SesionInvalida:
            resumen.append((ticket, "INTERRUMPIDO", archivos))
            raise
        except requests.exceptions.SSLError:
            resumen.append((ticket, "INTERRUMPIDO", archivos))
            raise
        except requests.RequestException as e:
            log(f"  ERROR de red en ticket {ticket}: {e}", flog)
            resumen.append((ticket, f"ERROR: {e}", archivos))
            continue
        except RuntimeError as e:
            log(f"  ERROR en ticket {ticket}: {e}", flog)
            primera = str(e).splitlines()[0]
            resumen.append((ticket, f"ERROR: {primera}", archivos))
            continue

        if errores_adj:
            estado = (f"INCOMPLETO: {len(errores_adj)} adjunto(s) con error "
                      f"({', '.join(errores_adj)})")
        else:
            estado = "CON ADJUNTOS" if archivos else "SIN ADJUNTOS"
        if not archivos and not errores_adj:
            log("  El ticket no tiene adjuntos.", flog)
        resumen.append((ticket, estado, archivos))

    return resumen, id_actual


def escribir_reporte(ruta: Path, resumen, id_final, modo):
    total = sum(len(a) for _, _, a in resumen)
    with open(ruta, "w", encoding="utf-8") as f:
        f.write("REPORTE DE DESCARGA DE ADJUNTOS\n")
        f.write(f"Fecha: {datetime.now():%Y-%m-%d %H:%M:%S}\n")
        f.write(f"Modo: {modo}\n")
        f.write(f"Tickets procesados: {len(resumen)}\n")
        f.write(f"Total de archivos descargados: {total}\n")
        if modo == "secuencial":
            f.write(f"Último id de adjunto probado: {id_final}\n")
        f.write("=" * 70 + "\n\n")
        for ticket, estado, archivos in resumen:
            f.write(f"Ticket: {ticket}\n")
            f.write(f"Estado: {estado}\n")
            f.write(f"Cantidad de archivos descargados: {len(archivos)}\n")
            if archivos:
                f.write("Archivos:\n")
                for a in archivos:
                    f.write(f"  - {a}\n")
            else:
                f.write("Archivos: ninguno\n")
            f.write("-" * 70 + "\n")


def diagnostico(cliente, ticket, adjunto):
    """Muestra qué responde el servidor, sin guardar nada."""
    pruebas = [
        ("Consulta del ticket", f"/api/v3/requests/{ticket}", {"Accept": API_ACCEPT}),
        ("Descarga de adjunto", f"/api/v3/requests/{ticket}/attachments/{adjunto}/_download", {}),
    ]
    print(f"Certificados de Windows (truststore): {'sí' if USA_TRUSTSTORE else 'no'}")
    for titulo, path, headers in pruebas:
        print("\n" + "=" * 60)
        print(f"{titulo}: {path}")
        try:
            r = cliente._get(path, headers=headers, stream=True)
        except SesionInvalida as e:
            print("  Resultado:            Sesión expirada / cookie no válida")
            print("  " + str(e).replace("\n", "\n  "))
            continue
        except requests.exceptions.SSLError:
            sys.exit(MSG_SSL)
        except requests.RequestException as e:
            sys.exit(f"No se pudo conectar con el servidor: {e}")
        print(f"  Código HTTP:          {r.status_code}")
        print(f"  Content-Type:         {r.headers.get('Content-Type', '-')}")
        print(f"  Content-Disposition:  {r.headers.get('Content-Disposition', '-')}")
        if r.headers.get("Location"):
            print(f"  Redirige a:           {r.headers['Location']}")
        ctype = r.headers.get("Content-Type", "").lower()
        es_texto = "json" in ctype or "text" in ctype or "html" in ctype
        if r.status_code != 200 or ("html" in ctype and "Content-Disposition" not in r.headers):
            r.content  # leer el cuerpo para poder interpretar el error
        tipo, mensaje = interpretar(r)
        print(f"  Resultado:            {TIPOS[tipo]}")
        if tipo != "ok":
            print("  " + mensaje.replace("\n", "\n  "))
        if es_texto and tipo != "ok":
            print("  Inicio de la respuesta:")
            print("   " + r.text.replace("\n", " ")[:400])
        r.close()
    print("\n" + "=" * 60)
    print(f"Listado de adjuntos del ticket {ticket}:")
    try:
        ids = cliente.listar_adjuntos(ticket)
        print(f"  Cantidad: {len(ids)}")
        for adj, nombre, url in ids:
            print(f"   - {adj}  {nombre}")
            if url:
                print(f"       url: {url}")
    except SesionInvalida as e:
        print("  " + str(e).replace("\n", "\n  "))
    except Exception as e:
        print(f"  No se pudo obtener el listado: {str(e).splitlines()[0]}")
    print("\nSi la descarga dice 'Respuesta correcta', ya puede ejecutar el proceso completo.")


def solo_listar(cliente, tickets, destino_base: Path):
    """Consulta los adjuntos de cada ticket y genera un listado, sin descargar."""
    marca = datetime.now().strftime("%Y%m%d_%H%M%S")
    ruta = destino_base / f"listado_adjuntos_{marca}.csv"
    total = 0
    with open(ruta, "w", encoding="utf-8-sig") as f:
        f.write("ticket;estado;cantidad;id_adjunto;nombre_archivo;url_descarga\n")
        for i, ticket in enumerate(tickets, 1):
            try:
                existe, tipo, msg = cliente.ticket_existe(ticket)
                if existe is False:
                    estado, ids = "NO EXISTE", []
                elif tipo == "permiso":
                    estado, ids = "SIN PERMISO", []
                else:
                    ids = cliente.listar_adjuntos(ticket)
                    estado = "CON ADJUNTOS" if ids else "SIN ADJUNTOS"
            except SesionInvalida:
                print(f"\nSesión expirada en el ticket {ticket}. Listado parcial en: {ruta}")
                raise
            except Exception as e:
                estado, ids = f"ERROR: {str(e).splitlines()[0]}", []
            total += len(ids)
            print(f"({i}/{len(tickets)}) {ticket}: {estado} - {len(ids)} adjunto(s)"
                  + (f"  [{', '.join(a for a, _, _ in ids)}]" if ids else ""))
            if ids:
                for adj, nombre, url in ids:
                    f.write(f"{ticket};{estado};{len(ids)};{adj};{nombre};{url}\n")
            else:
                f.write(f"{ticket};{estado};0;;;\n")
            f.flush()
    print(f"\nTotal de adjuntos encontrados: {total}")
    print(f"Listado guardado en: {ruta}  (se abre en Excel)")


def main():
    p = argparse.ArgumentParser(description="Descarga adjuntos de tickets de la Mesa de Servicio.")
    p.add_argument("--tickets", default=str(Path(__file__).with_name("tickets.txt")),
                   help="Archivo con los números de ticket (por defecto tickets.txt junto al script)")
    p.add_argument("--id-inicial", type=int, default=ID_INICIAL,
                   help=f"Id del primer adjunto (por defecto {ID_INICIAL})")
    p.add_argument("--destino", default=None,
                   help="Carpeta base de descarga (por defecto Mis documentos/AdjuntosMesaServicio)")
    p.add_argument("--modo", choices=("listado", "secuencial"), default="listado",
                   help="listado (recomendado): pide a la API los adjuntos de cada ticket. "
                        "secuencial: prueba ids consecutivos desde --id-inicial")
    p.add_argument("--base-url", default=BASE_URL)
    p.add_argument("--authtoken", default=os.environ.get("SDP_AUTHTOKEN"))
    p.add_argument("--cookie", default=os.environ.get("SDP_COOKIE") or COOKIE_SESION or None)
    p.add_argument("--no-verificar-ssl", action="store_true",
                   help="No validar el certificado (solo si el servidor usa uno interno)")
    p.add_argument("--pausa", type=float, default=1.0, help="Segundos entre peticiones (por defecto 1)")
    p.add_argument("--desde", default=None,
                   help="Número de ticket desde el cual empezar (omite los anteriores de la lista)")
    p.add_argument("--solo-listar", action="store_true",
                   help="Solo consulta y lista los adjuntos de cada ticket, sin descargar")
    p.add_argument("--solo-probar", action="store_true",
                   help="Solo valida la credencial con el primer ticket y termina")
    args = p.parse_args()

    ruta_cookie = Path(__file__).with_name("cookie.txt")
    if not args.authtoken and ruta_cookie.exists() and not os.environ.get("SDP_COOKIE"):
        texto_cookie = ruta_cookie.read_text(encoding="utf-8-sig").strip()
        if texto_cookie:
            args.cookie = texto_cookie
            print(f"Usando la cookie de {ruta_cookie.name}")

    if not args.authtoken and not args.cookie:
        print("No se encontró credencial (SDP_AUTHTOKEN o SDP_COOKIE).")
        print("  1) API key de técnico (authtoken)")
        print("  2) Cookie de sesión copiada del navegador")
        op = input("Elija 1 o 2: ").strip()
        if op == "1":
            args.authtoken = getpass.getpass("Pegue el authtoken: ").strip()
        else:
            args.cookie = getpass.getpass("Pegue el valor completo de la cabecera Cookie: ").strip()

    if args.no_verificar_ssl:
        import urllib3
        urllib3.disable_warnings()

    ruta_tickets = Path(args.tickets)
    if not ruta_tickets.exists():
        sys.exit(f"No se encontró el archivo de tickets: {ruta_tickets}")
    tickets = leer_tickets(ruta_tickets)
    if not tickets:
        sys.exit("El archivo de tickets no contiene números.")
    if args.desde:
        if args.desde not in tickets:
            sys.exit(f"El ticket {args.desde} no está en {ruta_tickets.name}.")
        tickets = tickets[tickets.index(args.desde):]
        print(f"Empezando desde el ticket {args.desde}")

    destino_base = Path(args.destino) if args.destino else carpeta_documentos() / "AdjuntosMesaServicio"
    destino_base.mkdir(parents=True, exist_ok=True)

    cliente = Cliente(args.base_url, args.authtoken, args.cookie,
                      verificar_ssl=not args.no_verificar_ssl, pausa=args.pausa)
    cliente.carpeta_diag = destino_base / "_diagnostico"

    if args.solo_probar:
        diagnostico(cliente, tickets[0], args.id_inicial)
        return

    if args.solo_listar:
        try:
            solo_listar(cliente, tickets, destino_base)
        except SesionInvalida as e:
            sys.exit(str(e))
        except requests.exceptions.SSLError:
            sys.exit(MSG_SSL)
        return

    marca = datetime.now().strftime("%Y%m%d_%H%M%S")
    ruta_log = destino_base / f"log_{marca}.txt"
    ruta_reporte = destino_base / f"reporte_descargas_{marca}.txt"

    print(f"Tickets a procesar: {len(tickets)}  |  Destino: {destino_base}")
    estado_global = {"resumen": [], "id_actual": args.id_inicial}
    codigo = 0
    with open(ruta_log, "w", encoding="utf-8") as flog:
        try:
            procesar(cliente, tickets, args.id_inicial, destino_base, args.modo,
                     flog, estado_global)
        except SesionInvalida as e:
            log(f"PROCESO DETENIDO: {e}", flog)
            if args.modo == "secuencial":
                log(f"Para continuar donde quedó, ejecute con:  --id-inicial {estado_global['id_actual']}"
                    " y deje en Tickets.txt solo los tickets pendientes (vea el reporte).", flog)
            else:
                log("Para continuar, renueve la cookie y ejecute de nuevo el mismo comando: "
                    "los archivos ya descargados se omiten.", flog)
            codigo = 2
        except requests.exceptions.SSLError:
            log(MSG_SSL, flog)
            codigo = 3
        except KeyboardInterrupt:
            log("Proceso cancelado por el usuario.", flog)
            codigo = 130
        finally:
            resumen = estado_global["resumen"]
            escribir_reporte(ruta_reporte, resumen, estado_global["id_actual"], args.modo)

    total = sum(len(a) for _, _, a in resumen)
    print(f"\nListo. Archivos descargados: {total}")
    print(f"Reporte: {ruta_reporte}")
    print(f"Log:     {ruta_log}")
    sys.exit(codigo)


if __name__ == "__main__":
    main()
