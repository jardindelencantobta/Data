#!/usr/bin/env python3
"""
Descarga los adjuntos de tickets de la Mesa de Servicio (ServiceDesk Plus, API v3).

Lógica (modo "secuencial", por defecto):
  - Se recorre la lista de tickets en orden.
  - El id de adjunto arranca en ID_INICIAL y baja de 1 en 1.
  - Mientras la descarga responda 200, se guarda el archivo y se prueba id - 1
    con el MISMO ticket.
  - Cuando responde 404, se pasa al SIGUIENTE ticket conservando el mismo id.
  - Si el ticket no existe, se registra y se pasa al siguiente.

Modo "listado" (opcional, --modo listado): consulta a la API la lista real de
adjuntos de cada ticket y los descarga, sin depender de que los ids sean
consecutivos.

Autenticación (elija una):
  - API key de técnico:  variable SDP_AUTHTOKEN  o  --authtoken
  - Cookie de sesión del navegador: variable SDP_COOKIE  o  --cookie
  - O la constante COOKIE_SESION definida más abajo en este archivo.
  Si no se da ninguna, el script la pide por consola (sin mostrarla).

Uso:
  python descargar_adjuntos.py
  python descargar_adjuntos.py --tickets tickets.txt --id-inicial 100024721
  python descargar_adjuntos.py --modo listado
  python descargar_adjuntos.py --solo-probar
"""

import argparse
import getpass
import os
import re
import sys
import time
from datetime import datetime
from pathlib import Path
from urllib.parse import unquote

try:
    import requests
    from requests.adapters import HTTPAdapter
    from urllib3.util.retry import Retry
except ImportError:
    sys.exit("Falta la librería 'requests'. Instálela con:  pip install requests")

BASE_URL = "https://mesadeservicio.colfondos.com.co"
ID_INICIAL = 100024721
API_ACCEPT = "application/vnd.manageengine.sdp.v3+json"

